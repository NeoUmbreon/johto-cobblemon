t.round = v.streak / 7;

'brain';
( t.round == 3 || t.round == 7 ) && q.npc.data.format == 'SINGLES' ? return 20;

'multiplayer bonus';
t.round = math.clamp(t.round, 1, 7);
q.length(q.player.data.temp.players) > 1 ? { t.base = t.base + t.round + 4 };

t.base = 2;
t.growth = 1;
t.round == 7 ? return t.base + t.growth * 5;
t.round >= 5 ? return t.base + t.growth * 3;
t.round >= 3 ? return t.base + t.growth * 2;
t.round >= 1 ? return t.base + t.growth * 1;