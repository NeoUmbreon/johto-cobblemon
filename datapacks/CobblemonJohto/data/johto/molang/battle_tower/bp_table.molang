t.round = math.clamp(v.streak / 7, 1, 7);
'multiplayer bonus';
q.length(q.npc.data.players) > 1 ? { t.bonus = t.round + 4 };

( t.round == 3 || t.round == 7 ) && q.npc.data.format == 'SINGLES' ? return 20;
t.round == 1 || t.round == 2 ? return 3 + t.bonus;
t.round == 3 || t.round == 4 ? return 4 + t.bonus;
t.round == 5 || t.round == 6 ? return 5 + t.bonus;
t.round == 7 ? return 7 + t.bonus;