'Init variables';
t.species_list = q.array();
t.filename_list = q.array();
t.trainer.team = q.array();


v.npc.name == 'Palmer' ? {
    'If Palmer, hardcode party';
    v.battle_num == 21 ? { t.filename_list = q.array('milotic_palmer_1','rhyperior_palmer_1','dragonite_palmer_1') };
    v.battle_num == 49 ? { t.filename_list = q.array('regigigas_palmer_2','heatran_palmer_2','cresselia_palmer_2') };
} : {
    'Else, generate species from pools';
    loop(100, {
        'Retrieve Pokemon filename';
        t.filename = q.run_script('johto:generate_pokemon');

        'Compare species to already picked list';
        t.match = 0;
        t.split = q.split_string(t.filename,'_');
        for_each(t.species, t.species_list, {
            t.split.0 == t.species ? {
                t.match = 1;
                break;
            };
        });

        'Append filename if species not already picked';
        !t.match ? {
            q.append(t.species_list, t.split.0);
            q.append(t.filename_list, t.filename);
        };

        'Break when party is filled';
        q.length(t.filename_list) == v.party_size ? break;
    });
};

'Fill team array';
for_each(t.filename, t.filename_list, {
    'Load Pokemon json';
    t.pokemon = q.file.load('data/molang/battle_frontier/pokemon/' + t.filename + '.json');
    q.file.clear('data/molang/battle_frontier/pokemon/' + t.filename + '.json');
    t.pokemon == 0 ? {
        q.run_command('say Error loading Pokemon json ' + t.filename + ', canceling battle');
        return 0;
    };

    'Reformat moveset as array';
    t.moveset = q.array();
    t.i = 0;
    loop(4, {
        t.i = t.i + 1;
        q.append(t.moveset, t.pokemon.moveset.[t.i])
    });
    t.pokemon.moveset = t.moveset;

    'Set constants';
    t.pokemon.level = 50;

    'Determine IVs from trainer numeric id';
    v.id <= 100 ? { t.ivs = 3; };
    v.id >= 101 && v.id <= 120 ? { t.ivs = 6; };
    v.id >= 121 && v.id <= 140 ? { t.ivs = 9; };
    v.id >= 141 && v.id <= 160 ? { t.ivs = 12; };
    v.id >= 161 && v.id <= 180 ? { t.ivs = 15; };
    v.id >= 181 && v.id <= 200 ? { t.ivs = 18; };
    v.id >= 201 && v.id <= 220 ? { t.ivs = 21; };
    v.id >= 221 ? { t.ivs = 31; };

    t.pokemon.ivs.hp = t.ivs;
    t.pokemon.ivs.atk = t.ivs;
    t.pokemon.ivs.def = t.ivs;
    t.pokemon.ivs.spa = t.ivs;
    t.pokemon.ivs.spd = t.ivs;
    t.pokemon.ivs.spe = t.ivs;

    'Append edited Pokemon object to team';
    q.append(t.trainer.team, t.pokemon);
});

'Write trainer to json';
t.trainer.name = v.npc.name;
q.file.save('data/molang/battle_frontier/' + v.rct_name + '.json',t.trainer);

'TBCS: Reload trainer and attach';
q.run_command('tbcs reload tbcs:' + v.rct_name);
q.run_command('tbcs attach tbcs:' + v.rct_name + ' ' + v.npc.uuid);

return 1;