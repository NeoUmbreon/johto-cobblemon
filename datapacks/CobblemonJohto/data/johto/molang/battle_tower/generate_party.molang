'Init variables';
t.species_list.0 = 0;
t.item_list.0 = 0;
q.delete_variables(t.species_list);
q.delete_variables(t.item_list);
t.team = q.array;


'Get roster';
t.roster = q.run_script('johto:get_roster');
t.roster_size = q.length(t.roster);

'shuffle';
t.i = 0;
loop(t.roster_size - 1, {
    t.i = t.i + 1;
    t.j = math.random_integer(0, t.i);
    t.temp = t.roster.[t.i];
    t.roster.[t.i] = t.roster.[t.j];
    t.roster.[t.j] = t.temp;
});

'scan';
t.index = 0;
loop(v.party_size, {
    t.found = 0;
    loop(t.roster_size, {
        'Load Pokemon data';
        t.pokemon = q.file.load('data/molang/battle_frontier/pokemon/' + (t.roster.[t.index]) + '.json');
        t.pokemon == 0 ? {
            q.run_command('say Error loading Pokemon json ' + (t.roster.[t.index]) + ', canceling battle');
            break;
        };
        t.index = t.index + 1;

        'Check for unique species and item';
        q.get_variable(t.species_list, t.pokemon.species) == 0 && q.get_variable(t.item_list, t.pokemon.helditem) == 0 ? {
            q.set_variable(t.species_list, t.pokemon.species, 1);
            q.set_variable(t.item_list, t.pokemon.helditem, 1);

            'Reformat moveset and item to comply with RCT';
            t.moveset = q.array;
            t.i = 0;
            loop(4, {
                t.i = t.i + 1;
                q.append(t.moveset, t.pokemon.moveset.[t.i])
            });
            t.pokemon.moveset = t.moveset;
            q.set_variable(t.pokemon, 'heldItem', t.pokemon.helditem);
            q.delete_variable(t.pokemon, 'helditem');

            'Set constants';
            t.pokemon.level = 50;

            'Determine IVs';
            t.ivs = 3;
            v.trainer.id >= 101 ? { t.ivs = 6 };
            v.trainer.id >= 121 ? { t.ivs = 9 };
            v.trainer.id >= 141 ? { t.ivs = 12 };
            v.trainer.id >= 161 ? { t.ivs = 15 };
            v.trainer.id >= 181 ? { t.ivs = 18 };
            v.trainer.id >= 201 ? { t.ivs = 21 };
            v.trainer.id >= 221 ? { t.ivs = 31 };

            t.pokemon.ivs.hp = t.ivs;
            t.pokemon.ivs.atk = t.ivs;
            t.pokemon.ivs.def = t.ivs;
            t.pokemon.ivs.spa = t.ivs;
            t.pokemon.ivs.spd = t.ivs;
            t.pokemon.ivs.spe = t.ivs;

            'Append edited Pokemon object to team';
            q.append(t.team, t.pokemon);
            t.found = 1;
            break;
        };
    });
    !t.found ? break;
});
q.length(t.team) != v.party_size ? return 0;

return t.team;