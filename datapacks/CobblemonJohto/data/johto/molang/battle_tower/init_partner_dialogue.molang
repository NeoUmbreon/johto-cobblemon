'check multi team';
for_each(t.npc, q.player.data.temp.npcs, {
    t.npc == q.npc.name ? { v.joined = true; break };
});
q.length(q.player.data.temp.npcs) > 0 && !v.joined ? {
    q.dialogue.close;
    return 0;
};

'generate party if missing';
t.id = q.to_lower(q.npc.name);
q.get_variable(q.player.data.temp, t.id) == 0 ? {
    v.party_size = 6;
    v.trainer.id = 300;
    v.trainer.roster = t.id;
    q.set_variable(q.player.data.temp, t.id, q.run_script('johto:generate_party'));
};

'format party for dialogue';
t.party = q.run_script('johto:get_partner_party', t.id);
v.display_party = q.array(q.array, q.array);
for_each(t.pokemon, t.party, {
    t.dummy_party = q.npc.create_npc_party;
    t.dummy_party.add_by_properties(t.pokemon.species);
    q.set_variable(v.display_party.[t.i], 'species', t.dummy_party.pokemon.0.species.name);

    t.move = q.get_move_from_id(t.pokemon.moveset.0);
    q.set_variable(v.display_party.[t.i], 'move', t.move.display_name);

    t.i = t.i + 1;
});