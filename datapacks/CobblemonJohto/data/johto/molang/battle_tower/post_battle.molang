v.player = v.players.0;
t.nursejoy = v.player.data.temp.npc;
t.nursejoy.data.battle_num = v.player.data.temp.battle_num + 1;
t.nursejoy.remove_tag('Locked');
t.format = q.to_lower(t.nursejoy.data.format);

'/kill';
for_each(t.npc, t.nursejoy.data.npcs, {
    q.run_command('tp ' + t.npc.uuid + ' -800 -50000 -280');
    '^c2me compatibility, otherwise i would love to just do t.npc.discard';
});

for_each(t.player, v.players, {
    t.player.remove_tag('BattleTowerReady');
    q.set_query('streaks', t.player.data.battle_tower.streaks);

    v.won ? {
        'update streaks';
        t.player.data.temp.battle_num > q.get_variable(q.streaks.current, t.format) ? q.set_variable(q.streaks.current, t.format, t.player.data.temp.battle_num);
        t.player.data.temp.battle_num > q.get_variable(q.streaks.lifetime, t.format) ? q.set_variable(q.streaks.lifetime, t.format, t.player.data.temp.battle_num);

        t.nursejoy.run_dialogue(t.player, 'battle_tower_nursejoy_post_battle');

    } : {
        'clear streak';
        q.set_variable(q.streaks.current, t.format, 0);

        t.player.party.heal;
    };
    
    t.player.save_data;
});

!v.won ? q.run_script('johto:leave_tower');