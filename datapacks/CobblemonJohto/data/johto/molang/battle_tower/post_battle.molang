t.nursejoy = v.players.0.data.temp.npc;
t.nursejoy.data.battle_num = v.players.0.data.temp.battle_num + 1;
t.nursejoy.remove_tag('Locked');

'/kill';
for_each(t.npc, t.nursejoy.data.npcs, {
    q.run_command('tp ' + t.npc.uuid + ' -800 -50000 -280');
    '^c2me compatibility, otherwise i would love to just do t.npc.discard';
});

for_each(t.player, v.players, {
    t.player.remove_tag('BattleTowerReady');
    v.won ? {
        'update streaks';
        t.nursejoy.data.format == 'SINGLES' ? {
            t.player.data.temp.battle_num > t.player.data.battle_tower.streaks.current.singles ? { t.player.data.battle_tower.streaks.current.singles = t.player.data.temp.battle_num };
            t.player.data.temp.battle_num > t.player.data.battle_tower.streaks.lifetime.singles ? { t.player.data.battle_tower.streaks.lifetime.singles = t.player.data.temp.battle_num };
        };
        t.nursejoy.data.format == 'DOUBLES' ? {
            t.player.data.temp.battle_num > t.player.data.battle_tower.streaks.current.doubles ? { t.player.data.battle_tower.streaks.current.doubles = t.player.data.temp.battle_num };
            t.player.data.temp.battle_num > t.player.data.battle_tower.streaks.lifetime.doubles ? { t.player.data.battle_tower.streaks.lifetime.doubles = t.player.data.temp.battle_num };
        };
        t.nursejoy.data.format == 'TRIPLES' ? {
            t.player.data.temp.battle_num > t.player.data.battle_tower.streaks.current.triples ? { t.player.data.battle_tower.streaks.current.triples = t.player.data.temp.battle_num };
            t.player.data.temp.battle_num > t.player.data.battle_tower.streaks.lifetime.triples ? { t.player.data.battle_tower.streaks.lifetime.triples = t.player.data.temp.battle_num };
        };
        t.nursejoy.data.format == 'MULTI' ? {
            t.player.data.temp.battle_num > t.player.data.battle_tower.streaks.current.multi ? { t.player.data.battle_tower.streaks.current.multi = t.player.data.temp.battle_num };
            t.player.data.temp.battle_num > t.player.data.battle_tower.streaks.lifetime.multi ? { t.player.data.battle_tower.streaks.lifetime.multi = t.player.data.temp.battle_num };
        };

        t.nursejoy.run_dialogue(t.player, 'battle_tower_nursejoy_post_battle');

    } : {
        t.player.party.heal;

        'clear streak';
        t.nursejoy.data.format == 'SINGLES' ? { t.player.data.battle_tower.streaks.current.singles = 0 };
        t.nursejoy.data.format == 'DOUBLES' ? { t.player.data.battle_tower.streaks.current.doubles = 0 };
        t.nursejoy.data.format == 'TRIPLES' ? { t.player.data.battle_tower.streaks.current.triples = 0 };
        t.nursejoy.data.format == 'MULTI' ? { t.player.data.battle_tower.streaks.current.multi = 0 };
    };
    t.player.save_data;
});

!v.won ? { v.player = v.players.0; q.run_script('johto:leave_tower'); };