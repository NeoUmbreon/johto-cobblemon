t.nursejoy = v.player.data.temp.npc;
t.nursejoy.remove_tag('Locked');
v.player.remove_tag('BattleTowerReady');

'/kill';
for_each(t.npc, t.nursejoy.data.npcs, {
    q.run_command('tp ' + t.npc.uuid + ' -800 -50000 -280');
    '^c2me compatibility, otherwise i would love to just do t.npc.discard';
});

v.won ? {
    'update streaks';
    t.nursejoy.data.format == 'SINGLES' ? {
        v.player.data.temp.battle_num > v.player.data.battle_tower.streaks.current.singles ? { v.player.data.battle_tower.streaks.current.singles = v.player.data.temp.battle_num };
        v.player.data.temp.battle_num > v.player.data.battle_tower.streaks.lifetime.singles ? { v.player.data.battle_tower.streaks.lifetime.singles = v.player.data.temp.battle_num };
    };
    t.nursejoy.data.format == 'DOUBLES' ? {
        v.player.data.temp.battle_num > v.player.data.battle_tower.streaks.current.doubles ? { v.player.data.battle_tower.streaks.current.doubles = v.player.data.temp.battle_num };
        v.player.data.temp.battle_num > v.player.data.battle_tower.streaks.lifetime.doubles ? { v.player.data.battle_tower.streaks.lifetime.doubles = v.player.data.temp.battle_num };
    };
    t.nursejoy.data.format == 'TRIPLES' ? {
        v.player.data.temp.battle_num > v.player.data.battle_tower.streaks.current.triples ? { v.player.data.battle_tower.streaks.current.triples = v.player.data.temp.battle_num };
        v.player.data.temp.battle_num > v.player.data.battle_tower.streaks.lifetime.triples ? { v.player.data.battle_tower.streaks.lifetime.triples = v.player.data.temp.battle_num };
    };
    t.nursejoy.data.format == 'MULTI' ? {
        v.player.data.temp.battle_num > v.player.data.battle_tower.streaks.current.multi ? { v.player.data.battle_tower.streaks.current.multi = v.player.data.temp.battle_num };
        v.player.data.temp.battle_num > v.player.data.battle_tower.streaks.lifetime.multi ? { v.player.data.battle_tower.streaks.lifetime.multi = v.player.data.temp.battle_num };
    };
    t.nursejoy.data.battle_num = v.player.data.temp.battle_num + 1;

    t.nursejoy.run_dialogue(v.player, 'battle_tower_nursejoy_post_battle');
} : {
    v.player.party.heal;

    'clear streak';
    t.nursejoy.data.format == 'SINGLES' ? { v.player.data.battle_tower.streaks.current.singles = 0 };
    t.nursejoy.data.format == 'DOUBLES' ? { v.player.data.battle_tower.streaks.current.doubles = 0 };
    t.nursejoy.data.format == 'TRIPLES' ? { v.player.data.battle_tower.streaks.current.triples = 0 };
    t.nursejoy.data.format == 'MULTI' ? { v.player.data.battle_tower.streaks.current.multi = 0 };

    q.run_script('johto:leave_tower');
};

v.player.save_data;