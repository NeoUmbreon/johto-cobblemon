'RNG trainer ranges';
v.min_id == 0 ? {
    v.min_id = 1;
    v.max_id = 100;
    v.battle_num == 7 ? { v.min_id = 101; v.max_id = 120 };
    v.battle_num >= 8 ? { v.min_id = 81; v.max_id = 120 };
    v.battle_num == 14 ? { v.min_id = 121; v.max_id = 140 };
    v.battle_num >= 15 ? { v.min_id = 101; v.max_id = 140 };
    v.battle_num == 21 ? { v.min_id = 141; v.max_id = 160 };
    v.battle_num >= 22 ? { v.min_id = 121; v.max_id = 160 };
    v.battle_num == 28 ? { v.min_id = 161; v.max_id = 180 };
    v.battle_num >= 29 ? { v.min_id = 141; v.max_id = 180 };
    v.battle_num == 35 ? { v.min_id = 181; v.max_id = 200 };
    v.battle_num >= 36 ? { v.min_id = 161; v.max_id = 200 };
    v.battle_num == 42 ? { v.min_id = 201; v.max_id = 220 };
    v.battle_num >= 43 ? { v.min_id = 181; v.max_id = 220 };
    v.battle_num == 49 ? { v.min_id = 221; v.max_id = 300 };
    v.battle_num >= 50 ? { v.min_id = 201; v.max_id = 300 };
};
t.id = math.random_integer(v.min_id, v.max_id);

'there is hardly a point to this, w/e idgaf';
v.trainer_registry == 0 ? { v.trainer_registry = q.file.load('data/molang/battle_frontier/trainer_registry.json') };

t.trainer = v.trainer_registry.[t.id];
t.trainer.id = t.id;
return t.trainer;