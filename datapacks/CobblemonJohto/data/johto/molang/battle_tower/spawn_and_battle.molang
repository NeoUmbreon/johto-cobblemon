'Read entity data, init variables';
t.players = q.player.data.temp.players;
t.format = q.npc.data.format;
v.battle_num = q.npc.data.battle_num;
t.floor = q.npc.data.floor;
t.prefix = 'battletower_floor_' + t.floor + '_trainer_';
t.tbcs_prefix = 'tbcs:' + t.prefix;
t.class_list = q.array();
t.trainer_list = q.array();
t.npcs = q.array();
t.team_size = q.length(t.players);
v.party_size = ( t.team_size != 1 ? 2 : ( t.format == 'SINGLES' ? 3 : ( t.format == 'DOUBLES' ? 4 : ( t.format == 'TRIPLES' ? 6 ))));
t.music_id = 11;


'Palmer handling';
t.team_size == 1 && t.format == 'SINGLES' ? {
    v.battle_num == 21 ? { t.palmer.class = 'towertycoon'; t.palmer.name = 'palmer'; t.palmer.id = 300; };
    v.battle_num == 49 ? { t.palmer.class = 'towertycoon'; t.palmer.name = 'palmer'; t.palmer.id = 300; };
};

t.palmer != 0 ? {
    'If Palmer, set variables';
    t.music_id = 15;
    q.append(t.trainer_list, t.palmer);
} : {
    'Else, generate random trainers';
    loop(100, {
        'Generate trainer';
        t.trainer = q.run_script('johto:generate_trainer');

        'Compare trainer class to already picked list';
        t.match = 0;
        for_each(t.class, t.class_list, {
            t.trainer.class == t.class ? {
                t.match = 1;
                break;
            };
        });

        'Append trainer if not already picked';
        !t.match ? {
            q.append(t.class_list, t.trainer.class);
            q.append(t.trainer_list, t.trainer);
        };

        'Break when team is filled';
        q.length(t.trainer_list) == t.team_size ? break;
    });
};

'Spawn trainers, generate and attach TBCS teams';
for_each(t.trainer, t.trainer_list, {
    t.filename = t.trainer.class + t.trainer.name;

    'Iterate runtime id';
    t.i = t.i + 1;
    v.rct_name = t.prefix + t.i;

    'Spawn NPC';
    v.npc = q.npc.world.spawn_npc(q.npc.x + t.i, q.npc.y, q.npc.z, t.filename, 1);
    v.npc == 0 ? {
        q.run_command('say Error spawning NPC with class ' + t.filename + ', canceling battle');
        return 0;
    };

    'Generate party';
    v.roster = t.trainer.roster;
    v.id = t.trainer.id;
    q.run_script('johto:generate_party') == 0 ? return 0;

    'Store NPC';
    q.append(t.npcs, v.npc);
});

'Store NPC objects in entity to discard after battle';
q.npc.data.npcs = t.npcs;
q.npc.save_data;

'Build battle command';
t.team_size == 1 ? {
    t.command = 'GEN_9_' + t.format + ' ' + t.players.0.uuid + ' vs ' + t.tbcs_prefix + '1';
} : {
    t.command = 'GEN_9_MULTI ' + t.players.0.uuid + ' ' + t.players.1.uuid + ' vs ' + t.tbcs_prefix + '1 ' + t.tbcs_prefix + '2';
};

'Pre-battle prep';
for_each(t.player, t.players, {
    t.player.data.temp.battle_num = v.battle_num;
    t.player.party.heal;
    q.run_command('scoreboard players set ' + t.player.username + ' BattleStart ' + t.music_id);
    q.run_command('execute as ' + t.player.username + ' run function johto:tools/forceclick');
});

'Run battle';
q.run_command('tbcs battle ' + t.command + ' rules {maxItemUses: 0}');

return 1;