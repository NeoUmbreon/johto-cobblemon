t.players = v.player.data.temp.players;
t.room = v.player.data.temp.npc.data.floor;

'free room';
v.player.world.server.data.battle_tower.room.[t.room] = 0;
v.player.world.server.save_data;

'/kill nurse joy';
v.player.data.temp.npc != 0 ? q.run_command('tp ' + v.player.data.temp.npc.uuid + ' -800 -50000 -280');

'kick out all players in party';
for_each(v.player, t.players, {
    v.player.active_dialogue.close;
    v.player.remove_tag('BattleTower');
    v.player.remove_tag('BattleSalon');
    v.player.teleport(903, 64, 68);
    q.run_script('johto:restore_party_levels');
    q.delete_variable(v.player.data, 'temp');

    q.run_command('opendialogue battletower_leave ' + v.player.username);
});