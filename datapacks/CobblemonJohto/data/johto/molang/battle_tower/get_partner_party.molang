'pass in partner id';
c.arg_1 == 0 ? return 0;
t.partner_party = q.get_variable(q.player.data.temp, c.arg_1);

'check species/item against player party';
t.chosen = q.array;
for_each(t.partner_pokemon, t.partner_party, {
    t.unique = true;

    for_each(t.player_pokemon, q.player.party.pokemon, {
        t.partner_pokemon.species == q.to_string(t.player_pokemon.species) || q.get_variable(t.partner_pokemon, 'heldItem') == q.to_string(t.player_pokemon.held_item.item) ? {
            t.unique = false;
            break;
        };
    });
    t.unique ? q.append(t.chosen, t.partner_pokemon);
    q.length(t.chosen) >= 2 ? break;
});

'fallback';
q.length(t.chosen) < 2 ? { t.chosen = q.array(t.partner_party.0, t.partner_party.1) };

return t.chosen;