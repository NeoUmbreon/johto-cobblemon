t.team_pokemon = q.array;
for_each(t.player, q.player.data.temp.players, {
    for_each(t.pokemon, t.player.party.pokemon, {
        q.append(t.team_pokemon, t.pokemon);
    });
});

'Duplicate species';
t.team_species = q.array;
for_each(t.pokemon, t.team_pokemon, {
    for_each(t.seen, t.team_species, {
        t.seen == t.pokemon.species.name ? {
            t.found == 0 ? { t.found = t.pokemon.species.name } : { t.found = q.replace(t.found, ' and', ','); t.found = t.found + ' and ' + t.pokemon.species.name; };
        };
    });
    q.append(t.team_species, t.pokemon.species.name);
});

'Return pass/fail';
t.found == 0 ? return 1 : return t.found;