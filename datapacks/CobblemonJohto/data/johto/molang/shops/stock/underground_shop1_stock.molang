'the Cobblemon counterparts of the Energy Powder and the Energy Root are the Fine/Superb Remedies';
'could add the Remedy and Energy Root for completion';
'reduced Revival Herb price significantly to reflect its reduced heal';

t.stock.0.name = 'Heal Powder';
t.stock.0.id = 'cobblemon:heal_powder';
t.stock.0.price = 300;
t.stock.0.desc = 'A very bitter medicinal powder. It heals all the status problems of a single Pokémon.';

t.stock.1.name = 'Fine Remedy';
t.stock.1.id = 'cobblemon:fine_remedy';
t.stock.1.price = 500;
t.stock.1.desc = 'A very bitter medicinal powder. It restores the HP of one Pokémon by 60 points.';

t.stock.2.name = 'Superb Remedy';
t.stock.2.id = 'cobblemon:superb_remedy';
t.stock.2.price = 1200;
t.stock.2.desc = 'A very bitter medicinal powder. It restores the HP of one Pokémon by 120 points.';

t.stock.3.name = 'Revival Herb';
t.stock.3.id = 'cobblemon:revival_herb';
t.stock.3.price = 700;
t.stock.3.desc = 'A terribly bitter medicinal herb. It revives a fainted Pokémon and restores a quarter of its maximum HP.';

return t.stock;