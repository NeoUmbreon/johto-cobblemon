t.stock.6.price = 3000;
t.stock.6.desc = 'A peculiar stone that can make certain species of Pokémon evolve. It is dark like the night sky.';

'post-natdex';
q.player.has_tag('Dialogue100') ? {
    t.stock.7.name = 'Shiny Stone';
    t.stock.7.id = 'cobblemon:shiny_stone';
    t.stock.7.price = 3000;
    t.stock.7.desc = 'A peculiar stone that can make certain species of Pokémon evolve. It shines with a dazzling light.';

