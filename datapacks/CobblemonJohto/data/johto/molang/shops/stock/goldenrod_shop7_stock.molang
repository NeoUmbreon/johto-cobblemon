'modeled after ZA Stone Emporium';
'Ice Stone is accessible pre-natdex because it is currently only used for Eevee/Glaceon';
'omitted Everstone because its not relevant in Cobblemon';

t.stock.0.name = 'Fire Stone';
t.stock.0.id = 'cobblemon:fire_stone';
t.stock.0.price = 3000;
t.stock.0.desc = 'A peculiar stone that can make certain species of Pokémon evolve. It has a fiery orange heart.';

t.stock.1.name = 'Water Stone';
t.stock.1.id = 'cobblemon:water_stone';
t.stock.1.price = 3000;
t.stock.1.desc = 'A peculiar stone that can make certain species of Pokémon evolve. It is the clear blue of a deep pool.';

t.stock.2.name = 'Thunder Stone';
