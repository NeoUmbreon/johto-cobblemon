'changes from base map:';
'- added missing items: Oval Stone, Prism Scale, Reaper Cloth';
'- removed Razor Fang/Claw, which are at the Battle Frontier';
'- checks story progress';
'- tried my best with the descriptions';

t.stock.0.name = 'King\'s Rock';
t.stock.0.id = 'cobblemon:kings_rock';
t.stock.0.price = 3000;
t.stock.0.desc = 'When the holder deals damage with its moves, there is a slight chance that targets will flinch. It\'s loved by certain Pokémon.';

t.stock.1.name = 'Metal Coat';
t.stock.1.id = 'cobblemon:metal_coat';
t.stock.1.price = 3000;
t.stock.1.desc = 'Boosts the power of the holder\'s Steel-type moves. It\'s loved by certain Pokémon.';

t.stock.2.name = 'Link Cable';
t.stock.2.id = 'cobblemon:link_cable';
t.stock.2.price = 3000;
t.stock.2.desc = 'A string exuding a mysterious energy that makes you feel a strange sense of connection. It\'s loved by certain Pokémon. ';

'post-natdex';
q.player.has_tag('Dialogue100') ? {
    t.stock.3.name = 'Dragon Scale';
    t.stock.3.id = 'cobblemon:dragon_scale';
    t.stock.3.price = 3000;
    t.stock.3.desc = 'A very tough and inflexible scale. It\'s loved by a certain Pokémon.';

    t.stock.4.name = 'Prism Scale';
    t.stock.4.id = 'cobblemon:prism_scale';
    t.stock.4.price = 3000;
    t.stock.4.desc = 'A mysterious scale that shines with a beautiful iridescence. It\'s loved by a certain Pokémon.';

    t.stock.5.name = 'Oval Stone';
    t.stock.5.id = 'cobblemon:oval_stone';
    t.stock.5.price = 3000;
    t.stock.5.desc = 'A peculiar stone. It is smooth and round. It\'s loved by a certain Pokémon.';

    t.stock.6.name = 'Upgrade';
    t.stock.6.id = 'cobblemon:upgrade';
    t.stock.6.price = 3000;
    t.stock.6.desc = 'A transparent device somehow filled with all sorts of data. It\'s loved by a certain Pokémon.';

    t.stock.7.name = 'Dubious Disc';
    t.stock.7.id = 'cobblemon:dubious_disc';
    t.stock.7.price = 3000;
    t.stock.7.desc = 'A transparent device overflowing with dubious data. It\'s loved by a certain Pokémon.';

    t.stock.8.name = 'Electirizer';
    t.stock.8.id = 'cobblemon:electirizer';
    t.stock.8.price = 3000;
    t.stock.8.desc = 'A box packed with a tremendous amount of electric energy. It\'s loved by a certain Pokémon.';

    t.stock.9.name = 'Magmarizer';
    t.stock.9.id = 'cobblemon:magmarizer';
    t.stock.9.price = 3000;
    t.stock.9.desc = 'A box packed with a tremendous amount of magma energy. It\'s loved by a certain Pokémon.';

    t.stock.10.name = 'Protector';
    t.stock.10.id = 'cobblemon:protector';
    t.stock.10.price = 3000;
    t.stock.10.desc = 'A protective item of some sort. It is extremely stiff and heavy. It\'s loved by a certain Pokémon.';

    t.stock.11.name = 'Reaper Cloth';
    t.stock.11.id = 'cobblemon:reaper_cloth';
    t.stock.11.price = 3000;
    t.stock.11.desc = 'A cloth imbued with horrifyingly strong spiritual energy. It\'s loved by a certain Pokémon.';
};


return t.stock;