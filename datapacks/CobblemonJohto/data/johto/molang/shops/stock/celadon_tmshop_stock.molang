t.stock.0.id = 'frustration';
t.stock.0.price = 1000;

t.stock.1.id = 'return';
t.stock.1.price = 1000;

t.stock.2.id = 'swagger';
t.stock.2.price = 1500;

t.stock.3.id = 'captivate';
t.stock.3.price = 1500;

t.stock.4.id = 'taunt';
t.stock.4.price = 1500;

t.stock.5.id = 'torment';
t.stock.5.price = 1500;

t.stock.6.id = 'safeguard';
t.stock.6.price = 2000;

t.stock.7.id = 'dig';
t.stock.7.price = 2000;

t.stock.8.id = 'stealthrock';
t.stock.8.price = 2000;

t.stock.9.id = 'brine';
t.stock.9.price = 3000;

t.stock.10.id = 'avalanche';
t.stock.10.price = 3000;

t.stock.11.id = 'darkpulse';
t.stock.11.price = 3000;

'fetch cobblemon names and descriptions';
for_each(t.tm, t.stock, {
    t.move = q.get_move_from_id(t.tm.id);
    t.tm.name = t.move.display_name + ' TM';
    t.tm.desc = t.move.description;
});

return t.stock;