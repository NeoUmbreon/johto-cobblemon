t.stock.0.name = 'Ultra Ball';
t.stock.0.id = 'cobblemon:ultra_ball';
t.stock.0.price = 800;
t.stock.0.desc = 'An ultra-performance Ball that provides a higher Pokémon catch rate than a Great Ball.';

t.stock.1.name = 'Hyper Potion';
t.stock.1.id = 'cobblemon:hyper_potion';
t.stock.1.price = 1500;
t.stock.1.desc = 'A spray-type medicine for wounds. It restores the HP of one Pokémon by 120 points.';

t.stock.2.name = 'Max Potion';
t.stock.2.id = 'cobblemon:max_potion';
t.stock.2.price = 2500;
t.stock.2.desc = 'A spray-type medicine for wounds. It completely restores the HP of a single Pokémon.';

t.stock.3.name = 'Full Restore';
t.stock.3.id = 'cobblemon:full_restore';
t.stock.3.price = 3000;
t.stock.3.desc = 'A medicine that fully restores the HP and heals any status problems of a single Pokémon.';

t.stock.4.name = 'Revive';
t.stock.4.id = 'cobblemon:revive';
