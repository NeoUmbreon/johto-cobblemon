t.stock.0.name = 'Heal Ball';
t.stock.0.id = 'cobblemon:heal_ball';
t.stock.0.price = 300;
t.stock.0.desc = 'A remedial Poké Ball that restores the caught Pokémon\'s HP and PP, and eliminates any status problem.';

t.stock.1.name = 'Net Ball';
t.stock.1.id = 'cobblemon:net_ball';
t.stock.1.price = 1000;
t.stock.1.desc = 'A somewhat different Poké Ball that works especially well on Water- and Bug-type Pokémon.';

return t.stock;