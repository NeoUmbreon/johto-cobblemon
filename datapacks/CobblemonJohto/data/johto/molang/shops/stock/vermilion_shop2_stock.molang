t.stock.0.name = 'Nest Ball';
t.stock.0.id = 'cobblemon:nest_ball';
t.stock.0.price = 1000;
t.stock.0.desc = 'A somewhat different Poké Ball that works especially well on weaker Pokémon in the wild.';

t.stock.1.name = 'Dusk Ball';
t.stock.1.id = 'cobblemon:dusk_ball';
t.stock.1.price = 1000;
t.stock.1.desc = 'A somewhat different Poké Ball that makes it easier to catch wild Pokémon in the dark.';

t.stock.2.name = 'Quick Ball';
t.stock.2.id = 'cobblemon:quick_ball';
t.stock.2.price = 1000;
t.stock.2.desc = 'A somewhat different Poké Ball that provides a better catch rate if it is used at the start of a wild encounter.';

return t.stock;