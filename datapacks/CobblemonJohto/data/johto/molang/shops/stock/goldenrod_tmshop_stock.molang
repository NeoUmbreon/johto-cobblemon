t.stock.0.id = 'flash';
t.stock.0.price = 1000;

t.stock.1.id = 'protect';
t.stock.1.price = 2000;

t.stock.2.id = 'falseswipe';
t.stock.2.price = 2000;

t.stock.3.id = 'naturalgift';
t.stock.3.price = 2000;

t.stock.4.id = 'lightscreen';
t.stock.4.price = 2000;

t.stock.5.id = 'reflect';
t.stock.5.price = 2000;

t.stock.6.id = 'solarbeam';
t.stock.6.price = 3000;

t.stock.7.id = 'focusblast';
t.stock.7.price = 5500;

t.stock.8.id = 'fireblast';
t.stock.8.price = 5500;

t.stock.9.id = 'thunder';
t.stock.9.price = 5500;

t.stock.10.id = 'blizzard';
t.stock.10.price = 5500;

t.stock.11.id = 'hyperbeam';
t.stock.11.price = 7500;

'fetch cobblemon names and descriptions';
for_each(t.tm, t.stock, {
    t.move = q.get_move_from_id(t.tm.id);
    t.tm.name = t.move.display_name + ' TM';
    t.tm.desc = t.move.description;
});

return t.stock;