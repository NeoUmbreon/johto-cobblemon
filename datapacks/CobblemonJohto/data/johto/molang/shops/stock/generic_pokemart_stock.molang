'get badge count';
t.badges = 0;
for_each(t.leader, q.array('Falkner','Bugsy','Whitney','Morty','Chuck','Jasmine','Pryce','Clair'), {
    q.player.has_tag(t.leader) ? { t.badges = t.badges + 1 };
});

'filter stock based on badge count';
'for_each would not process in the correct order, have to use loop';
t.i = 0;
t.filtered = q.array;
loop(q.length(t.stock), {
    t.item = t.stock.[t.i];
    t.badges >= t.item.required_badges ? {
        q.append(t.filtered, t.item);
    };
    t.i = t.i + 1;
});

return t.filtered;