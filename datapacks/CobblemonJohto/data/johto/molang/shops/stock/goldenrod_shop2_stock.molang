t.stock.0.price = 200;
t.stock.0.desc = 'A device for catching wild Pokémon. It is thrown like a ball at the target. It is designed as a capsule system.';

t.stock.1.name = 'Great Ball';
t.stock.1.id = 'cobblemon:great_ball';
t.stock.1.price = 600;
t.stock.1.desc = 'A good, high-performance Ball that provides a higher Pokémon catch rate than a standard Poké Ball.';

t.stock.2.name = 'Ultra Ball';
t.stock.2.id = 'cobblemon:ultra_ball';
t.stock.2.price = 800;
t.stock.2.desc = 'An ultra-performance Ball that provides a higher Pokémon catch rate than a Great Ball.';

t.stock.3.name = 'Escape Rope';
