q.player == 0 || q.npc == 0 || !q.file.exists('data/molang/players/' + q.player.uuid + '.json') ? return 0;

'fetch json name';
t.trainer_id = q.get_variable(q.split_string(q.npc.class, 'cobblemon:'), '1');
q.is_included(t.trainer_id, 'silver') ? { t.trainer_id = t.trainer_id + math.clamp(q.to_int(q.player.data.starter.species), 1, 3) };

'fallback to regular party if challenge json missing';
!q.file.exists('data/molang/challengemode_trainers/' + t.trainer_id + '.json') ? return 0;

'load file';
t.trainer = q.file.load('data/molang/challengemode_trainers/' + t.trainer_id + '.json');

'create party';
t.party_store = q.npc.create_npc_party;
t.rct_trainer.team = q.array();
for_each(t.raw_data, t.trainer.party, {
    'parse species and level with cobblemon to fetch moveset, ability, etc';
    t.party_store.add_by_properties(t.raw_data.properties);

    'reformat to rctapi';
    q.set_query('pokemon_in', t.party_store.pokemon.[t.i]);
    q.set_query('pokemon_out', t.rct_trainer.team.[t.i]);
    q.pokemon_out.species = t.raw_data.species;
    q.pokemon_out.level = t.raw_data.level;
    t.raw_data.species == 0 || t.raw_data.level == 0 ? { q.player.tell('Something went wrong! (trainer: ' + t.trainer_id + ', #: ' + t.i); break; };

    q.pokemon_out.nature = ( t.raw_data.nature != 0 ? t.raw_data.nature : q.random('hardy','docile','bashful','quirky','serious') );
    q.pokemon_out.ability = ( t.raw_data.ability != 0 ? t.raw_data.ability : q.pokemon_in.ability );
    q.length(t.raw_data.ivs) != 0 ? { q.pokemon_out.ivs = t.raw_data.ivs } : { 'TODO: could set to random ivs from pokemon_in' };
    q.length(t.raw_data.evs) != 0 ? { q.pokemon_out.evs = t.raw_data.evs };
    t.raw_data.helditem != 0 ? { q.set_variable(q.pokemon_out, 'heldItem', t.raw_data.helditem) };
    q.pokemon_out.moveset = q.array();
    q.length(t.raw_data.moveset) != 0 ? {
        for_each(t.move, t.raw_data.moveset, {
            q.append(q.pokemon_out.moveset, t.move);
        });
    } : {
        'this may be excessive, but probably prudent to check moveset length';
        t.j = 0;
        loop(4, {
            t.move = q.pokemon_in.moveset.[t.j];
            t.move.name != 0 ? q.append(q.pokemon_out.moveset, t.move.name) : break;
            t.j = t.j + 1;
        });
    };

    t.i = t.i + 1;
});

'write, save, battle';
t.trainer.ai != 0 ? { t.rct_trainer.ai = t.trainer.ai };
t.trainer.name != 0 ? { t.rct_trainer.name = t.trainer.name } : { t.rct_trainer.name = q.npc.name };

q.file.save('data/molang/players/' + q.player.uuid + '.json', t.rct_trainer);

q.run_command('tbcs reload tbcs:' + q.player.uuid);
q.run_command('tbcs battle GEN_9_SINGLES ' + q.player.uuid + ' ' + q.npc.uuid + ' as tbcs:' + q.player.uuid);

return 1;