q.player.in_battle || q.player.has_tag('Whiteout') ? return 0;

!q.is_blank(q.npc.config.requirements) && !q.run_molang(q.npc.config.requirements) ? return q.npc.run_dialogue(q.player, q.npc.config.trainer_id + '_interaction_fail');

q.player.has_tag('defeated.' + q.npc.config.trainer_id) ? return q.npc.run_dialogue(q.player, q.npc.class + '_end_defeated');

!q.player.party.has_usable_pokemon ? return q.run_command('tellraw ' + q.player.username + ' {"text":"You have no usable Pokémon!","italic":true,"color":"gray"}');

q.npc.config.doubles ? {
    for_each(t.pokemon, q.player.party.pokemon, {
        t.pokemon.current_hp > 0 ? { t.usable_pokemon = t.usable_pokemon + 1 };
    });
    t.usable_pokemon < 2 ? return q.npc.run_dialogue(q.player, q.npc.class + '_interaction');
};

q.run_script('johto:prebattle_dialogue');

return 1;