q.set_query('player', c.player);
q.set_query('npc', c.npc);

q.player.in_battle ? return 0;
q.player.has_tag('Whiteout') ? return 0;

q.player.has_tag('defeated.' + q.npc.Config.trainer_id) ? return q.npc.run_dialogue(q.player, q.npc.Config.trainer_id + '_end_defeated');

!q.player.party.has_usable_pokemon ? return q.run_command('tellraw ' + q.player.username + ' {"text":"You have no usable Pokémon!","italic":true,"color":"gray"}');

q.run_script('johto:prebattle_dialogue');

return 1;