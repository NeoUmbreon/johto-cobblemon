!q.file.exists('data/molang/config.json') ? {
    'set defaults';
    t.config.max_challenge_distance = 6;
    t.config.challenge_mode = false;
    t.config.hot_reload = false;

    q.file.save('data/molang/config.json', t.config);
} : {
    'clear cache';
    q.file.clear('data/molang/config.json');

    'populate old config with newly-added variables';
};