!c.player.main_held_item.item.is_of('blaze_rod') || c.player.in_battle || math.mod(c.player.world.game_time, 14) != 0 ? return 0;

q.set_query('config', c.player.world.server.data);
t.entities = q.player.get_nearby_entities(q.config.max_challenge_distance * 2);
t.trainers = q.file.load('data/molang/trainers.json');
q.file.clear('data/molang/trainers.json');

for_each(t.entity, t.entities, {
    t.entity.is_npc ? {
        q.set_query('npc', t.entity);
        t.class = q.get_variable(q.split_string(q.npc.class,'cobblemon:'), '1');
        t.trainer_data = q.get_variable(t.trainers, t.class);

        'check if trainer';
        t.trainer_data != 0 && !t.trainer_data.no_autobattle ? {
            'use different particles if trainer has override';
            q.is_blank(t.trainer_data.challenge_distance) ? {
                t.radius = q.config.default_challenge_distance;
                t.particle = 'cobblemon:hisuipuff';
            } : {
                t.radius = t.trainer_data.challenge_distance;
                t.particle = 'cobblemon:radius';
            };

            t.angle = 0;
            t.steps = t.radius * 20;
            t.step_amount = 360 / t.steps;
            loop(t.steps, {
                c.player.world.spawn_bedrock_particles(
                    t.particle,
                    q.npc.x + t.radius * math.cos(t.angle),
                    q.npc.y,
                    q.npc.z + t.radius * math.sin(t.angle),
                    c.player
                );
                t.angle = t.angle + t.step_amount;
            });
        };
    };
});