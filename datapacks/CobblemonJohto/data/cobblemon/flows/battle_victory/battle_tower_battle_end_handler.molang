for_each(t.player, c.players, {
    !t.player.player.has_tag('BattleTowerReady') ? return 0;
});

q.length(c.player_losers) == 0 ? { v.won = true } : { v.won = false };

for_each(t.player, c.players, {
    v.player = t.player.player;

    'Run victory music';
    v.won ? {
        q.run_command('execute as ' + v.player.uuid + ' if score @s BattleStart matches 15 run scoreboard players set @s BattleEnd 7');
        q.run_command('execute as ' + v.player.uuid + ' if score @s BattleStart matches 11 run scoreboard players set @s BattleEnd 1');
    } : {
        q.run_command('execute as ' + v.player.uuid + ' run scoreboard players set @s BattleStart 0');
        q.run_command('execute as ' + v.player.uuid + ' run function johto:tools/forceclick');
    };

    q.run_molang('q.run_script(\'johto:post_battle\')', 2);
});