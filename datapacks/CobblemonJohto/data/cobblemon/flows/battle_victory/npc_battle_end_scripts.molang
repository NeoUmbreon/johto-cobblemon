c.battle.is_pvn == false ? return 0;

'clear stored battle data';
for_each(t.player, c.players, {
    q.delete_variable(t.player.player.data, 'battle');
});

t.trainers = q.file.load('data/molang/trainers.json');

'with TBCS, reference the actual NPC with c.scriptable_losers/winners instead of c.npcs';
for_each(t.loser, c.scriptable_losers, {
    t.loser.is_npc ? {
        q.set_query('npc', t.loser);
        t.class = q.get_variable(q.split_string(q.npc.class,'cobblemon:'), '1');
        t.trainer_data = q.get_variable(t.trainers, t.class);

        !q.is_blank(t.trainer_data) ? {
            for_each(t.player_winner, c.player_winners, {
                q.set_query('player', t.player_winner.player);

                t.trainer_id = t.trainer_data.doubles_id != 0 ? t.trainer_data.doubles_id : t.class;
                q.player.add_tag('defeated.' + t.trainer_id);
                q.npc.run_dialogue(q.player, t.trainer_id + '_end');
            });
        };
    };
});

for_each(t.winner, c.scriptable_winners, {
    t.winner.is_npc ? {
        q.set_query('npc', t.winner);
        t.class = q.get_variable(q.split_string(q.npc.class,'cobblemon:'), '1');
        t.trainer_data = q.get_variable(t.trainers, t.class);

        !q.is_blank(t.trainer_data) ? {
            for_each(t.player_loser, c.player_losers, {
                q.set_query('player', t.player_loser.player);

                q.run_script('cobblemon:generic_forfeit');
            });
        };
    };
});

return 1;

'currently unused, might be useful in the future?';
for_each(t.npc_actor, c.npcs, {
    t.npc_actor.npc.config.challenge_cooldown != 0 ? {
        for_each(t.player_actor, c.players, {
            t.data = t.player_actor.player.get_npc_data(t.npc_actor.npc.uuid);
            t.data.last_challenged_time = t.player_actor.player.world.game_time;
            t.player_actor.player.save_data();
        });
    };
});