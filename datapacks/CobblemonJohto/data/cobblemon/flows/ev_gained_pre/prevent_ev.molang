c.pokemon.owner.battle.is_pvp ? q.cancel;

c.pokemon.owner.has_tag('BattleTower') || c.pokemon.owner.has_tag('BattleFactory') ? {
    q.cancel;
};

c.pokemon.owner.has_tag('BattleFactory') ? {
    c.source == 'interaction' ? q.run_command('tellraw ' + c.pokemon.owner.username + ' {"text":"You can\'t use that right now!","color":"gray","italic":true}');
};