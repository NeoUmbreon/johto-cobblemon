c.player.has_tag('BattleTower') ? {
    v.players = c.player.data.temp.players;
    c.player.has_tag('BattleTowerReady') ? { q.run_script('johto:post_battle') } : { q.run_script('johto:leave_tower') };
};

c.player.has_tag('BattleSalon') ? {
    q.set_query('player', c.player);
    q.run_script('johto:leave_team');
};

c.player.has_tag('SafariState') ? {
    q.run_command('execute as ' + c.player.username + ' run function johto:triggers/safarizone/leave');
};

!q.is_blank(c.player.data.battle) ? {
    c.player.in_battle && c.player.data.battle.whiteout_on_disconnect ? c.player.add_tag('Whiteout');
    q.delete_variable(c.player.data, 'battle');
};

c.player.in_battle ? {
    t.players = q.array();
    t.npcs = q.array();

    for_each(t.actor, c.player.battle.actors, {
        t.actor.is_player ? { q.append(t.players, t.actor.player); };
        t.actor.is_npc ? { q.append(t.npcs, t.actor.npc); };
    });

    for_each(t.player, t.players, {
        q.run_command('scoreboard players set ' + t.player.username + ' BattleStart 0');
        q.run_command('execute as ' + t.player.username + ' run function johto:tools/forceclick');
    });
};

c.player.save_data;