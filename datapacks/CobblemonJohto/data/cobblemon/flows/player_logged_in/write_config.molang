q.set_query('server', c.player.world.server);
q.set_query('config', q.server.data);

'set defaults';
t.max_challenge_distance = 96;
q.config.max_challenge_distance != t.max_challenge_distance ? {
    q.config.max_challenge_distance = t.max_challenge_distance;
    t.resave = true;
};

q.is_blank(q.config.default_challenge_distance) ? {
    q.config.default_challenge_distance = 6;
    t.resave = true;
};

t.resave ? q.server.save_data;