q.is_blank(q.player.data.battle) ? return 0;
q.set_query('battle', q.player.data.battle);

'perimeter particles';
t.radius = q.battle.max_battle_distance;
t.angle = 0;
t.steps = t.radius * 20;
t.step_amount = 360 / t.steps;
loop(t.steps, {
    q.player.world.spawn_bedrock_particles(
        'cobblemon:radius',
        q.battle.x + t.radius * math.cos(t.angle),
        q.battle.y,
        q.battle.z + t.radius * math.sin(t.angle),
        q.player
    );
    t.angle = t.angle + t.step_amount;
});


q.player.distance_to_pos(q.battle.x, q.battle.y, q.battle.z) > q.battle.max_battle_distance ? {
    q.player.teleport(q.battle.x, q.battle.y, q.battle.z);
    q.run_command('tellraw ' + q.player.username + ' {"text":"No! There\'s no running from a Trainer battle!","italic":true,"color":"gray"}');
};