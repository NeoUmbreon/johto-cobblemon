'load data';
q.set_query('config', q.player.world.server.data);

t.trainers = q.file.load('data/molang/trainers.json');
q.set_query('class', q.get_variable(q.split_string(q.npc.class,'cobblemon:'), '1'));
q.set_query('trainer_data', q.get_variable(t.trainers, q.class));

'do player stuff';
q.player.remove_tag('InDialogue');
q.run_command('scoreboard players set ' + q.player.username + ' BattleStart ' + c.arg_1);
q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');

'start battle';
'if challenge_mode_disabled, or challenge mode script fails, uses npc entity party';
q.set_query('format', q.is_blank(q.trainer_data.doubles_id) ? 'singles' : 'doubles');
q.config.challenge_mode_disabled || !q.run_script('johto:instantiate_rctapi_trainer') ? q.npc.start_battle(q.player, q.format);