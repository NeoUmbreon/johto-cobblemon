q.player.data.battle.trainer = q.npc.Config.trainer_id;
q.player.data.battle.whiteout_on_disconnect = !q.npc.Config.trainer;
q.player.data.battle.x = q.npc.x;
q.player.data.battle.y = q.npc.y;
q.player.data.battle.z = q.npc.z;
q.player.data.battle.max_battle_distance = (q.is_blank(q.npc.Config.challenge_distance) ? q.player.world.server.data.max_challenge_distance : q.npc.Config.challenge_distance);
q.player.data.battle.max_battle_distance = q.player.data.battle.max_battle_distance + 0.5;

q.npc.data.battle.player = q.player.username;