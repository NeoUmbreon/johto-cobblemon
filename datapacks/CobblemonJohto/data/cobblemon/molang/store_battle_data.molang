q.get_variable(q.file.load('data/molang/config.json'), 'hotReload') == true ? q.file.clear('data/molang/config.json');
t.max_challenge_distance = q.get_variable(q.file.load('data/molang/config.json'), 'maxChallengeDistance');

q.player.data.battle.whiteout_on_disconnect = !q.npc.config.auto_battle;
q.player.data.battle.x = q.npc.x;
q.player.data.battle.y = q.npc.y;
q.player.data.battle.z = q.npc.z;
q.player.data.battle.max_battle_distance = (q.is_blank(q.npc.config.challenge_distance) ? t.max_challenge_distance : q.npc.config.challenge_distance);
q.player.data.battle.max_battle_distance = q.player.data.battle.max_battle_distance + 0.5;