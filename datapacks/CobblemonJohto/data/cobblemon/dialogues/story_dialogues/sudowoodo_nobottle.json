{
    "initializationAction": [
        "q.player.add_tag('InDialogue');"
    ],
    "escapeAction": [],
    "speakers": {
        "player": {
            "face": "q.player.face(true);",
            "name": {
           "type": "expression",
           "expression": "q.player.username"
         }
       },
        "sudowoodo": {
      "name": "Weird Tree",
      "face": {
        "type": "artificial",
        "modelType": "pokemon",
        "identifier": "cobblemon:sudowoodo",
        "isLeftSide": false
      }
    }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "player",
            "lines": [
                "It's a weird tree."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.player.remove_tag('InDialogue');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}