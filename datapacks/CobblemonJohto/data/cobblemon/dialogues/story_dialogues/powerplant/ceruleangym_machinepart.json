{   
    "initializationAction": [
        "q.player.add_tag('InDialogue');"
    ],
    "escapeAction": [              
    ],
    "speakers": {
        "player": {
         "face": "q.player.face(true);",
         "name": {
        "type": "expression",
        "expression": "q.player.username"
      }
    }
      },
    "pages": [
        {
            "id": "greeting",
            "speaker": "player",
            "lines": [
                "It's the Machine Part!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function johto:sound/playlocalsfx {sfx:\"keyitem\"}');",
                            "q.dialogue.set_page('page2');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "player",
            "lines": [
                "You put it in your inventory."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.player.add_tag('Dialogue220');",
                            "q.player.remove_tag('InDialogue');",
                            "q.dialogue.close();"
                            ]
                    }
                ]
            }
        }
        ]
    }