{
    "initializationAction": [
        "q.run_command('team join battletower ' + q.player.username);",
        "v.page_length = 3;",
        "v.physical_moves = q.array('aerialace','brickbreak','uturn','xscissor','stoneedge','earthquake');",
        "v.physical_prices = q.array(40,40,40,64,80,80);",
        "v.special_moves = q.array('shadowball','energyball','sludgebomb','dragonpulse');",
        "v.special_prices = q.array(64,64,80,80);",
        "v.status_moves = q.array('toxic','thunderwave','willowisp','attract','bulkup','calmmind');",
        "v.status_prices = q.array(32,32,32,32,48,48);"
    ],
    "escapeAction": [
        "q.run_command('team join default ' + q.player.username);",
        "q.dialogue.close;"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting1",
            "speaker": "npc",
            "lines": [
                "Welcome to the Exchange Service Corner!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },{
            "id": "greeting2",
            "speaker": "npc",
            "lines": [
                "Would you like to trade in your BP for some prizes?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": "q.dialogue.next_page;"
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('leave');"
                    }
                ]
            }
        },
        {
            "id": "categories",
            "speaker": "npc",
            "lines": [
                "Please choose the TM you would like."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Physical",
                        "value": "physical",
                        "action": [
                            "q.set_query('moves', v.physical_moves);",
                            "q.set_query('prices', v.physical_prices);",
                            "v.index = 0;",
                            "v.max_index = v.page_length * math.ceil(q.length(q.moves) / v.page_length);",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Special",
                        "value": "special",
                        "action": [
                            "q.set_query('moves', v.special_moves);",
                            "q.set_query('prices', v.special_prices);",
                            "v.index = 0;",
                            "v.max_index = v.page_length * math.ceil(q.length(q.moves) / v.page_length);",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Status",
                        "value": "status",
                        "action": [
                            "q.set_query('moves', v.status_moves);",
                            "q.set_query('prices', v.status_prices);",
                            "v.index = 0;",
                            "v.max_index = v.page_length * math.ceil(q.length(q.moves) / v.page_length);",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Exit",
                        "value": "leave",
                        "action": "q.dialogue.set_page('leave');"
                    }
                ]
            }
        },


        {
            "id": "movelist",
            "speaker": "npc",
            "lines": [
                "Please choose the TM you would like."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "value": "page_forward",
                        "text": {
                            "type": "expression",
                            "expression": "'Page ' + (v.index / v.page_length + 1) + ' / ' + (v.max_index / v.page_length) + ' >>';"
                        },
                        "isVisible": "q.length(q.moves) > v.page_length + 1;",
                        "action": [
                            "v.index = v.index + v.page_length; v.index >= v.max_index ? { v.index = 0 };",
                            "q.dialogue.set_page('movelist');"
                        ]
                    },
                    {
                        "value": "move0",
                        "text": {
                            "type": "expression",
                            "expression": "t.index = v.index + 0; q.moves.[t.index] == 0 ? return ''; t.move = q.get_move_from_id(q.moves.[t.index]); return t.move.display_name + ': ' + (q.prices.[t.index]) + ' BP';"
                        },
                        "isVisible": "q.length(q.moves) > 0;",
                        "isSelectable": "q.moves.[v.index + 0] != 0;",
                        "action": [
                            "v.move = q.get_move_from_id(q.moves.[v.index + 0]);",
                            "v.price = q.prices.[v.index + 0];",
                            "q.dialogue.next_page;"
                        ]

                    },
                    {
                        "value": "move1",
                        "text": {
                            "type": "expression",
                            "expression": "t.index = v.index + 1; q.moves.[t.index] == 0 ? return ''; t.move = q.get_move_from_id(q.moves.[t.index]); return t.move.display_name + ': ' + (q.prices.[t.index]) + ' BP';"
                        },
                        "isVisible": "q.length(q.moves) > 1;",
                        "isSelectable": "q.moves.[v.index + 1] != 0;",
                        "action": [
                            "v.move = q.get_move_from_id(q.moves.[v.index + 1]);",
                            "v.price = q.prices.[v.index + 1];",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "value": "move2",
                        "text": {
                            "type": "expression",
                            "expression": "t.index = v.index + 2; q.moves.[t.index] == 0 ? return ''; t.move = q.get_move_from_id(q.moves.[t.index]); return t.move.display_name + ': ' + (q.prices.[t.index]) + ' BP';"
                        },
                        "isVisible": "q.length(q.moves) > 2;",
                        "isSelectable": "q.moves.[v.index + 2] != 0;",
                        "action": [
                            "v.move = q.get_move_from_id(q.moves.[v.index + 2]);",
                            "v.price = q.prices.[v.index + 2];",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "value": "moveend",
                        "text": {
                            "type": "expression",
                            "expression": "t.index = v.page_length; q.moves.[t.index] == 0 ? return ''; t.move = q.get_move_from_id(q.moves.[t.index]); return t.move.display_name + ': ' + (q.prices.[t.index]) + ' BP';"
                        },
                        "isVisible": "q.length(q.moves) - 1 == v.page_length;",
                        "action": [
                            "v.move = q.get_move_from_id(q.moves.[v.page_length]);",
                            "v.price = q.prices.[v.page_length];",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('categories');"
                    }
                ]
            }
        },


        {
            "id": "confirmation",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "v.move.display_name + ': ' + v.move.description"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": {
                            "type": "expression",
                            "expression": "'Buy: ' + v.price + ' BP'"
                        },
                        "value": "buy",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' if score @s BattlePoints matches ' + v.price + '.. run tag @s add CanBuy');",
                            "!q.player.has_tag('CanBuy') ? { v.result_page = 'buyfail' };",
                            "q.player.has_tag('CanBuy') ? { q.player.remove_tag('CanBuy'); q.run_command('scoreboard players remove ' + q.player.username + ' BattlePoints ' + v.price); q.run_command('execute as ' + q.player.username + ' run function johto:sound/playlocalsfx {sfx:\"transaction\"}'); q.run_command('givetm ' + v.move.name + ' ' + q.player.username); v.result_page = 'buysuccess' };",
                            "q.dialogue.set_page(v.result_page);"
                        ]
                    },
                    {
                        "text": "Cancel",
                        "value": "cancel",
                        "action": [
                            "q.dialogue.set_page('movelist');"
                        ]
                    }
                ]
            }
        },

        
        {
            "id": "buysuccess",
            "speaker": "none",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Obtained the ' + v.move.display_name + ' TM!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('movelist');"
                    }
                ]
            }
        },
        {
            "id": "buyfail",
            "speaker": "npc",
            "lines": [
                "I'm sorry, but you don't have enough BP."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('movelist');"
                    }
                ]
            }
        },


        {
            "id": "leave",
            "speaker": "npc",
            "lines": [
                "Please come back any time you want!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('team join default ' + q.player.username);",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        }
    ]
}