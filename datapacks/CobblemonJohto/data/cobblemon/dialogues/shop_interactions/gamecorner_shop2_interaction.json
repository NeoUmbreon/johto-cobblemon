{
    "initializationAction": [
        "q.run_command('team join Coins ' + q.player.username);",
        "v.page_length = 3;",
        "v.message = 'We exchange your Coins for fabulous prizes!';",
        "v.names = q.array('Abra','Ekans','Sandshrew','Dratini');",
        "v.species = q.array('abra','ekans','sandshrew','dratini','mrmime','eevee','porygon');",
        "v.prices = q.array(200,700,700,2100,3333,6666,9999);",
        "q.player.has_tag('FlyCeladon') ? { v.expanded_stock = true };",
        "v.expanded_stock && !q.player.data.update_gc_stock ? { v.message = 'We have some new stock in from the old Game Corner in Kanto.\nTake a look!'; q.player.data.update_gc_stock = 1; q.player.save_data };",
        "v.expanded_stock ? { v.names = q.array('Abra','Ekans','Sandshrew','Dratini','Mr. Mime','Eevee','Porygon') };",
        "v.max_index = v.page_length * math.ceil(q.length(v.names) / v.page_length);"
    ],
    "escapeAction": [
        "q.run_command('team join default ' + q.player.username);",
        "q.dialogue.close;"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
               "Welcome!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },


        {
            "id": "selection",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "v.message"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "value": "page_forward",
                        "text": {
                            "type": "expression",
                            "expression": "'Page ' + (v.index / v.page_length + 1) + ' / ' + (v.max_index / v.page_length) + ' >>';"
                        },
                        "isVisible": "q.length(v.names) > v.page_length + 1;",
                        "action": [
                            "v.index = v.index + v.page_length; v.index >= v.max_index ? { v.index = 0 };",
                            "q.dialogue.set_page('selection');"
                        ]
                    },
                    {
                        "value": "sel0",
                        "text": {
                            "type": "expression",
                            "expression": "t.index = v.index + 0; v.names.[t.index] == 0 ? return '' : { return v.names.[t.index] + ': ' + (v.prices.[t.index]) + ' Coins' };"
                        },
                        "isVisible": "q.length(v.names) > 0;",
                        "isSelectable": "v.names.[v.index + 0] != 0;",
                        "action": [
                            "v.sel_index = v.index + 0;",
                            "q.dialogue.next_page;"
                        ]

                    },
                    {
                        "value": "sel1",
                        "text": {
                            "type": "expression",
                            "expression": "t.index = v.index + 1; v.names.[t.index] == 0 ? return '' : { return v.names.[t.index] + ': ' + (v.prices.[t.index]) + ' Coins'};"
                        },
                        "isVisible": "q.length(v.names) > 1;",
                        "isSelectable": "v.names.[v.index + 1] != 0;",
                        "action": [
                            "v.sel_index = v.index + 1;",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "value": "sel2",
                        "text": {
                            "type": "expression",
                            "expression": "t.index = v.index + 2; v.names.[t.index] == 0 ? return '' : { return v.names.[t.index] + ': ' + (v.prices.[t.index]) + ' Coins'};"
                        },
                        "isVisible": "q.length(v.names) > 2;",
                        "isSelectable": "v.names.[v.index + 2] != 0;",
                        "action": [
                            "v.sel_index = v.index + 2;",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "value": "selend",
                        "text": {
                            "type": "expression",
                            "expression": "v.names.[v.page_length] == 0 ? return '' : { return v.names.[v.page_length] + ': ' + (v.prices.[v.page_length]) + ' Coins'};"
                        },
                        "isVisible": "q.length(v.names) - 1 == v.page_length;",
                        "action": [
                            "v.sel_index = v.page_length;",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Exit",
                        "value": "exit",
                        "action": "q.dialogue.set_page('leave');"
                    }
                ]
            }
        },


        {
            "id": "confirmation",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Would you like ' + (v.names.[v.sel_index]) + '?'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": {
                            "type": "expression",
                            "expression": "'Buy: ' + (v.prices.[v.sel_index]) + ' Coins'"
                        },
                        "value": "buy",
                        "action": [
                            "v.message = 'Is there anything else you\\'d like?';",
                            "q.run_command('execute as ' + q.player.username + ' if score @s Coins matches ' + (v.prices.[v.sel_index]) + '.. run tag @s add CanBuy');",
                            "!q.player.has_tag('CanBuy') ? { v.result_page = 'buyfail' };",
                            "q.player.has_tag('CanBuy') ? { q.player.remove_tag('CanBuy'); q.run_command('scoreboard players remove ' + q.player.username + ' Coins ' + (v.prices.[v.sel_index])); q.run_command('execute as ' + q.player.username + ' run function johto:sound/playlocalsfx {sfx:\"transaction\"}'); q.player.party.add_by_properties(v.species.[v.sel_index] + ' level=15'); v.result_page = 'buysuccess' };",
                            "q.dialogue.set_page(v.result_page);"
                        ]
                    },
                    {
                        "text": "Cancel",
                        "value": "cancel",
                        "action": [
                            "v.message = 'Is there anything else you\\'d like?';",
                            "q.dialogue.set_page('selection');"
                        ]
                    }
                ]
            }
        },


        {
            "id": "buysuccess",
            "speaker": "none",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'You received the ' + (v.names.[v.sel_index]) + '!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('selection');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "buyfail",
            "speaker": "npc",
            "lines": [
                "Sorry! You need more Coins."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('selection');"
                    }
                ]
            }
        },


        {
            "id": "leave",
            "speaker": "npc",
            "lines": [
                "Please save your Coins and come again!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('team join default ' + q.player.username);",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        }
    ]
}