{
    "initializationAction": [
        "q.set_query('stock', q.run_script('johto:get_stock'));",
        "q.run_command('team join battletower ' + q.player.username);",
        "v.page_length = 3;"
    ],
    "escapeAction": [
        "q.run_command('team join default ' + q.player.username);",
        "q.dialogue.close;"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting1",
            "speaker": "npc",
            "lines": [
                "Welcome to the Exchange Service Corner!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "greeting2",
            "speaker": "npc",
            "lines": [
                "Would you like to trade in your BP for some prizes?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": "q.dialogue.next_page;"
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('leave');"
                    }
                ]
            }
        },
        {
            "id": "categories",
            "speaker": "npc",
            "lines": [
                "Please choose the TM you would like."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Physical",
                        "value": "physical",
                        "action": [
                            "v.stock = q.stock.physical;",
                            "v.index = 0;",
                            "v.max_index = v.page_length * math.ceil(q.length(v.stock) / v.page_length);",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Special",
                        "value": "special",
                        "action": [
                            "v.stock = q.stock.special;",
                            "v.index = 0;",
                            "v.max_index = v.page_length * math.ceil(q.length(v.stock) / v.page_length);",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Status",
                        "value": "status",
                        "action": [
                            "v.stock = q.stock.status;",
                            "v.index = 0;",
                            "v.max_index = v.page_length * math.ceil(q.length(v.stock) / v.page_length);",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Exit",
                        "value": "leave",
                        "action": "q.dialogue.set_page('leave');"
                    }
                ]
            }
        },
        {
            "id": "list",
            "speaker": "npc",
            "lines": [
                "Please choose the TM you would like."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "value": "page_forward",
                        "text": {
                            "type": "expression",
                            "expression": "'Page ' + (v.index / v.page_length + 1) + ' / ' + (v.max_index / v.page_length) + ' >>';"
                        },
                        "isVisible": "q.length(v.stock) > v.page_length + 1;",
                        "action": [
                            "v.index = v.index + v.page_length; v.index >= v.max_index ? { v.index = 0 };",
                            "q.dialogue.set_page('list');"
                        ]
                    },
                    {
                        "value": "sel0",
                        "text": {
                            "type": "expression",
                            "expression": "t.elem = v.stock.[v.index + 0]; t.elem.name == 0 ? return '' : { return t.elem.name + ': ' + t.elem.price + ' BP' };"
                        },
                        "isVisible": "q.length(v.stock) > 0;",
                        "isSelectable": "v.stock.[v.index + 0] != 0;",
                        "action": [
                            "q.set_query('elem', v.stock.[v.index + 0]);",
                            "q.dialogue.set_page('confirmation');"
                        ]
                    },
                    {
                        "value": "sel1",
                        "text": {
                            "type": "expression",
                            "expression": "t.elem = v.stock.[v.index + 1]; t.elem.name == 0 ? return '' : { return t.elem.name + ': ' + t.elem.price + ' BP' };"
                        },
                        "isVisible": "q.length(v.stock) > 1;",
                        "isSelectable": "v.stock.[v.index + 1] != 0;",
                        "action": [
                            "q.set_query('elem', v.stock.[v.index + 1]);",
                            "q.dialogue.set_page('confirmation');"
                        ]
                    },
                    {
                        "value": "sel2",
                        "text": {
                            "type": "expression",
                            "expression": "t.elem = v.stock.[v.index + 2]; t.elem.name == 0 ? return '' : { return t.elem.name + ': ' + t.elem.price + ' BP' };"
                        },
                        "isVisible": "q.length(v.stock) > 2;",
                        "isSelectable": "v.stock.[v.index + 2] != 0;",
                        "action": [
                            "q.set_query('elem', v.stock.[v.index + 2]);",
                            "q.dialogue.set_page('confirmation');"
                        ]
                    },
                    {
                        "value": "selend",
                        "text": {
                            "type": "expression",
                            "expression": "t.elem = v.stock.[v.page_length]; t.elem.name == 0 ? return '' : { return t.elem.name + ': ' + t.elem.price + ' BP' };"
                        },
                        "isVisible": "q.length(v.stock) - 1 == v.page_length;",
                        "action": [
                            "q.set_query('elem', v.stock.[v.page_length]);",
                            "q.dialogue.set_page('confirmation');"
                        ]
                    },
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('categories');"
                    }
                ]
            }
        },
        {
            "id": "confirmation",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "q.elem.name + ': ' + q.elem.desc"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": {
                            "type": "expression",
                            "expression": "'Buy: ' + q.elem.price + ' BP'"
                        },
                        "value": "buy1",
                        "action": [
                            "v.result = q.run_script('johto:buy_from_shop','tm',q.elem.id,'BattlePoints',q.elem.price,1);",
                            "q.dialogue.set_page(v.result == 1 ? 'buysuccess' : 'buyfail');"
                        ]
                    },
                    {
                        "text": "Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('list');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "buysuccess",
            "speaker": "none",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Obtained the ' + q.elem.name + ' TM!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('list');"
                    }
                ]
            }
        },
        {
            "id": "buyfail",
            "speaker": "npc",
            "lines": [
                "I'm sorry, but you don't have enough BP."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('list');"
                    }
                ]
            }
        },
        {
            "id": "leave",
            "speaker": "npc",
            "lines": [
                "Please come back any time you want!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('team join default ' + q.player.username);",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        }
    ]
}