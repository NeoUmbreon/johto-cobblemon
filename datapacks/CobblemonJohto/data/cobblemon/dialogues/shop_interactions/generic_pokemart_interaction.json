{
    "initializationAction": [
        "v.stock = q.run_script('johto:get_stock');",
        "q.run_script('johto:shop_dialogue');",
        "q.run_command('team join shops ' + q.player.username);",
        "v.page_length = 3;",
        "v.index = 0;",
        "v.max_index = v.page_length * math.ceil(q.length(v.stock) / v.page_length);"
    ],
    "escapeAction": [
        "q.run_command('team join default ' + q.player.username);",
        "q.dialogue.close;"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "list",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "q.replace(v.greeting_msg,'\\n','\n')"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "value": "page_forward",
                        "text": {
                            "type": "expression",
                            "expression": "'Page ' + (v.index / v.page_length + 1) + ' / ' + (v.max_index / v.page_length) + ' >>';"
                        },
                        "isVisible": "q.length(v.stock) > v.page_length + 1;",
                        "action": [
                            "v.index = v.index + v.page_length; v.index >= v.max_index ? { v.index = 0 };",
                            "q.dialogue.set_page('list');"
                        ]
                    },
                    {
                        "value": "sel0",
                        "text": {
                            "type": "expression",
                            "expression": "t.elem = v.stock.[v.index + 0]; t.elem.name == 0 ? return '' : { return t.elem.name + ': $' + t.elem.price };"
                        },
                        "isVisible": "q.length(v.stock) > 0;",
                        "isSelectable": "v.stock.[v.index + 0] != 0;",
                        "action": [
                            "q.set_query('elem', v.stock.[v.index + 0]);",
                            "v.greeting_msg = v.reprompt_msg;",
                            "q.dialogue.set_page('confirmation');"
                        ]
                    },
                    {
                        "value": "sel1",
                        "text": {
                            "type": "expression",
                            "expression": "t.elem = v.stock.[v.index + 1]; t.elem.name == 0 ? return '' : { return t.elem.name + ': $' + t.elem.price };"
                        },
                        "isVisible": "q.length(v.stock) > 1;",
                        "isSelectable": "v.stock.[v.index + 1] != 0;",
                        "action": [
                            "q.set_query('elem', v.stock.[v.index + 1]);",
                            "v.greeting_msg = v.reprompt_msg;",
                            "q.dialogue.set_page('confirmation');"
                        ]
                    },
                    {
                        "value": "sel2",
                        "text": {
                            "type": "expression",
                            "expression": "t.elem = v.stock.[v.index + 2]; t.elem.name == 0 ? return '' : { return t.elem.name + ': $' + t.elem.price };"
                        },
                        "isVisible": "q.length(v.stock) > 2;",
                        "isSelectable": "v.stock.[v.index + 2] != 0;",
                        "action": [
                            "q.set_query('elem', v.stock.[v.index + 2]);",
                            "v.greeting_msg = v.reprompt_msg;",
                            "q.dialogue.set_page('confirmation');"
                        ]
                    },
                    {
                        "value": "selend",
                        "text": {
                            "type": "expression",
                            "expression": "t.elem = v.stock.[v.page_length]; t.elem.name == 0 ? return '' : { return t.elem.name + ': $' + t.elem.price };"
                        },
                        "isVisible": "q.length(v.stock) - 1 == v.page_length;",
                        "action": [
                            "q.set_query('elem', v.stock.[v.page_length]);",
                            "v.greeting_msg = v.reprompt_msg;",
                            "q.dialogue.set_page('confirmation');"
                        ]
                    },
                    {
                        "text": "Exit",
                        "value": "exit",
                        "action": "q.dialogue.set_page('leave');"
                    }
                ]
            }
        },
        {
            "id": "confirmation",
            "speaker": "none",
            "lines": [
                {
                    "type": "expression",
                    "expression": "q.elem.name + ': ' + q.elem.desc"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": {
                            "type": "expression",
                            "expression": "'Buy 1: $' + q.elem.price"
                        },
                        "value": "buy1",
                        "action": [
                            "v.result = q.run_script('johto:buy_from_shop','item',q.elem.id,'Money',q.elem.price,1);",
                            "q.dialogue.set_page(v.result == 1 ? 'buysuccess' : 'buyfail');"
                        ]
                    },
                    {
                        "text": {
                            "type": "expression",
                            "expression": "'Buy 5: $' + q.elem.price * 5"
                        },
                        "value": "buy5",
                        "action": [
                            "v.result = q.run_script('johto:buy_from_shop','item',q.elem.id,'Money',q.elem.price,5);",
                            "q.dialogue.set_page(v.result == 1 ? 'buysuccess' : 'buyfail');"
                        ]
                    },
                    {
                        "text": {
                            "type": "expression",
                            "expression": "'Buy 10: $' + q.elem.price * 10"
                        },
                        "value": "buy10",
                        "action": [
                            "v.result = q.run_script('johto:buy_from_shop','item',q.elem.id,'Money',q.elem.price,10);",
                            "q.dialogue.set_page(v.result == 1 ? 'buysuccess' : 'buyfail');"
                        ]
                    },
                    {
                        "text": "Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('list');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "buysuccess",
            "speaker": "npc",
            "lines": [
                "Here you are!",
                "Thank you!",
                {
                    "type": "expression",
                    "expression": "v.extra_dialogue == 0 ? '' : v.extra_dialogue"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "v.extra_dialogue = 0;",
                            "q.dialogue.set_page('list');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "buyfail",
            "speaker": "npc",
            "lines": [
                "You don't have enough money."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('list');"
                    }
                ]
            }
        },
        {
            "id": "leave",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "q.replace(v.farewell_msg,'\\n','\n')"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('team join default ' + q.player.username);",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        }
    ]
}