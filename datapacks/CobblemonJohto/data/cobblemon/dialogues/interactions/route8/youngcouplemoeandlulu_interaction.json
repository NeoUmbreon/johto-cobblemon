{
    "initializationAction": [
        "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 4');",
        "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');"
    ],
    "escapeAction": [
        "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 0');",
        "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
        "q.dialogue.close();"
    ],
    "speakers": {
        "moe": {
            "name": "Moe",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:youngcouplem",
                "isLeftSide": true
            }
        },
        "lulu": {
            "name": "Lulu",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:youngcouplef",
                "isLeftSide": false
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "moe",
            "lines": [
                "Do I look weak?\nDon't make me laugh!\nWhen I'm with Lulu, I've got a hundred times more courage!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "lulu",
            "lines": [
                "Moe and I make a great pair! You should prepare yourself!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 11');",
                            "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
                            "v.battle = q.npc.start_battle(q.player);"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 0');",
                            "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
