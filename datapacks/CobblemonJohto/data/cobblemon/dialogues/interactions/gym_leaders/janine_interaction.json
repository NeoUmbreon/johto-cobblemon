                "isLeftSide": true
            }
        },
        "unknown": {
            "name": "???",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:janine",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "unknown",
            "lines": [
                "Fufufufu...",
                "I'm sorry to disappoint you..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "battle_prompt",
            "speaker": "unknown",
            "lines": [
                "I'm only joking! I'm the real deal!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "battle_start",
            "speaker": "janine",
            "lines": [
                "Janine of Fuchsia Gym, that's me!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 18');",
                            "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
                            "q.dialogue.close();",
                            "v.battle = q.npc.start_battle(q.player);"
                        ]
                    }
                ]
            }
        }
    ]
