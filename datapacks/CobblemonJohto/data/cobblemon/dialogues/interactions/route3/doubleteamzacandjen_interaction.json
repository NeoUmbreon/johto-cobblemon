{
    "initializationAction": [
        "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 8');",
        "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');"
    ],
    "escapeAction": [
        "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 0');",
        "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
        "q.dialogue.close();"
    ],
    "speakers": {
        "zac": {
            "name": "Zac",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:acetrainerm",
                "isLeftSide": true
            }
        },
        "jen": {
            "name": "Jen",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:acetrainerf",
                "isLeftSide": false
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "zac",
            "lines": [
                "Really, you want to battle us?\nYou've got a lot of courage for someone so young."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "jen",
            "lines": [
                "Huh? You'd like to go up against us? Great!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 11');",
                            "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
                            "v.battle = q.npc.start_battle(q.player);"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 0');",
                            "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}