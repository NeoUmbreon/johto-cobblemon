{   "initializationAction": [              
    "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 3');",
    "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');"
        ],
    "escapeAction": [              
        "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 0');",
        "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
        "q.dialogue.close();"
        ],
    "names": ["Li"],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();"
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": ["So good of you to come here!"],
                  "input": {
                      "type": "option",
                      "vertical": false,
                      "options": [
                          {
                              "text": "Next",
                              "value": "next",
                              "action": "q.dialogue.next_page;"
                          }
                      ]
                  }
              },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": ["Sprout Tower is a place of training.\nPeople and Pokémon test their bonds to build a bright future together.\nI am the final test."],
                  "input": {
                      "type": "option",
                      "vertical": false,
                      "options": [
                          {
                              "text": "Next",
                              "value": "next",
                              "action": "q.dialogue.next_page;"
                          }
                      ]
                  }
              },
          {
              "id": "page3",
              "speaker": "npc",
              "lines": [
                  "Allow me to check the ties between you and your Pokémon!"
              ],
              "input": {
                  "type": "option",
                  "vertical": false,
                  "options": [
                      {
                          "text": "§c⚔ Battle ⚔§r",
                          "value": "battle",
                          "action": [                           
                                      "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 11');",
                                      "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
                                      "v.battle = q.npc.start_battle(q.player);"
                              ]
                      },
                      {
                          "text": "No",
                          "value": "no",
                          "action": [              
                              "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 0');",
                              "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
                              "q.dialogue.close();"]
                          }
                      ]
                  }
              }
        ]
    }