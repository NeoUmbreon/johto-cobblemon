{
  "initializationAction": [
    "q.npc.set_chatting();"
  ],
  "speakers": {
    "npc": {
      "name": " ",
      "face": "q.npc.face"
    }
  },
  "pages": [
    {
      "id": "greeting",
      "speaker": "npc",
      "lines": [
        "Hello, and welcome to the Pokémon Center."
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Next",
            "value": "next",
            "action": "q.dialogue.next_page;"
          }
        ]
      }
    },
    {
      "id": "greeting2",
      "speaker": "npc",
      "lines": [
        "We restore your tired Pokémon to full health."
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Next",
            "value": "next",
            "action": "q.dialogue.next_page;"
          }
        ]
      }
    },
    {
      "id": "greeting3",
      "speaker": "npc",
      "lines": [
        "Would you like to rest your Pokémon?"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Yes",
            "value": "yes",
            "action": "q.dialogue.set_page('confirmed');"
          },
          {
            "text": "No",
            "value": "no",
            "action": "q.dialogue.set_page('okbye');"
          }
        ]
      }
    },
    {
      "id": "confirmed",
      "speaker": "npc",
      "lines": [
        "OK, I'll take your Pokémon for a few seconds."
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Ok",
            "value": "ok",
            "action": [
              "v.healer = q.npc.find_nearby_block('cobblemon:healing_machine');",
              "v.has_healer = v.healer != 0;",
              "v.has_charge = v.has_healer && q.player.can_heal_at_healer(v.healer);",
              "v.callback_dialogue = 'nursejoy_healed';",
              "q.npc.run_action_effect('pokecenter_heal');",
              "q.dialogue.close();"
            ]
          }
        ]
      }
    },
    {
      "id": "okbye",
      "speaker": "npc",
      "lines": [
        "Please, come back again any time!"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Close",
            "value": "close",
            "action": "q.dialogue.close();"
          }
        ]
      }
    }
  ]
}