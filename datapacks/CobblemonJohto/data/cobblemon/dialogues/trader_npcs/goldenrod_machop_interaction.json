{
    "initializationAction": [
        "v.requested = 'drowzee';",
        "v.given = 'machop gender=female nick=Muscle ability=guts nature=lonely ottype=NPC ot=Jose hp_iv=15 attack_iv=25 defence_iv=20 special_attack_iv=15 special_defence_iv=15 speed_iv=20';",
        "q.player.data.machop_trade ? q.dialogue.set_page('already_traded');"
    ],
    "speakers": {
        "npc": {
            "name": "Jose",
            "face": "q.npc.face;"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "I collect Pokémon.",
                "Do you have a Drowzee?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "confirmation",
            "speaker": "npc",
            "lines": [
                "Want to trade it for my Machop?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "v.success = q.run_script('pt_trade_pkmn', v.requested, v.given);",
                            "v.success ? { q.player.data.machop_trade = 1; q.player.save_data };",
                            "v.success ? q.dialogue.set_page('trade') : q.dialogue.set_page('no_pokemon');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('declined');"
                    }
                ]
            }
        },
        {
            "id": "trade",
            "speaker": "none",
            "lines": [
                "Jose sent over Muscle.",
                "Bye-bye, Drowzee!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "after_trade",
            "speaker": "npc",
            "lines": [
                "Yay! I got myself a Drowzee!",
                "Thanks!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "no_pokemon",
            "speaker": "npc",
            "lines": [
                "You don't have a Drowzee?",
                "What a letdown..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "declined",
            "speaker": "npc",
            "lines": [
                "You don't want to trade? Aww..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "already_traded",
            "speaker": "npc",
            "lines": [
                "Hi, how's my old Machop doing?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}