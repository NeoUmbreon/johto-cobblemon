{
    "initializationAction": [
        "v.requested = 'dugtrio';",
        "v.given = 'magneton nick=Maggie helditem=cobblemon:metal_coat ability=magnetpull nature=impish ottype=NPC ot=Lorenzo hp_iv=15 attack_iv=20 defence_iv=15 special_attack_iv=20 special_defence_iv=20 speed_iv=20';",
        "q.player.data.magneton_trade ? q.dialogue.set_page('already_traded');"
    ],
    "speakers": {
        "npc": {
            "name": "Lorenzo",
            "face": "q.npc.face;"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "I collect Pokémon.",
                "Do you have a Dugtrio?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "confirmation",
            "speaker": "npc",
            "lines": [
                "Want to trade it for my Magneton?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "v.success = q.run_script('pt_trade_pkmn', v.requested, v.given);",
                            "v.success ? { q.player.data.magneton_trade = 1; q.player.save_data };",
                            "v.success ? q.dialogue.set_page('trade') : q.dialogue.set_page('no_pokemon');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('declined');"
                    }
                ]
            }
        },
        {
            "id": "trade",
            "speaker": "none",
            "lines": [
                "Lorenzo sent over Maggie.",
                "Bye-bye, Dugtrio!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "after_trade",
            "speaker": "npc",
            "lines": [
                "Yay! I got myself a Dugtrio!",
                "Thanks!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "no_pokemon",
            "speaker": "npc",
            "lines": [
                "You don't have a Dugtrio?",
                "What a letdown..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "declined",
            "speaker": "npc",
            "lines": [
                "You don't want to trade? Aww..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "already_traded",
            "speaker": "npc",
            "lines": [
                "Hi, how's my old Magneton doing?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}