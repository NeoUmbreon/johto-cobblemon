{
    "initializationAction": [
        "v.requested = 'dragonair gender=female';",
        "v.given = 'dodrio gender=female nick=Doris helditem=cobblemon:smoke_ball ability=runaway nature=impish ottype=NPC ot=Ayana hp_iv=20 attack_iv=20 defence_iv=20 special_attack_iv=15 special_defence_iv=15 speed_iv=15';",
        "q.player.data.dodrio_trade ? q.dialogue.set_page('already_traded');"
    ],
    "speakers": {
        "npc": {
            "name": "Ayana",
            "face": "q.npc.face;"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Dragonair's cute, but I don't have one. Do you have a female Dragonair?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "confirmation",
            "speaker": "npc",
            "lines": [
                "Want to trade it for my Dodrio?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "v.success = q.run_script('pt_trade_pkmn', v.requested, v.given);",
                            "v.success ? { q.player.data.dodrio_trade = 1; q.player.save_data };",
                            "v.success ? q.dialogue.set_page('trade') : q.dialogue.set_page('no_pokemon');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('declined');"
                    }
                ]
            }
        },
        {
            "id": "trade",
            "speaker": "none",
            "lines": [
                "Ayana sent over Doris.",
                "Bye-bye, Dragonair!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "after_trade",
            "speaker": "npc",
            "lines": [
                "Wow! Thank you!",
                "I always wanted a Dragonair!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "no_pokemon",
            "speaker": "npc",
            "lines": [
                "You don't have a female Dragonair.",
                "Please trade with me if you get one."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "declined",
            "speaker": "npc",
            "lines": [
                "You don't want to trade?",
                "Oh, darn..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "already_traded",
            "speaker": "npc",
            "lines": [
                "How is that Dodrio I traded you doing?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "already_traded2",
            "speaker": "npc",
            "lines": [
                "Your Dragonair's so cute!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}