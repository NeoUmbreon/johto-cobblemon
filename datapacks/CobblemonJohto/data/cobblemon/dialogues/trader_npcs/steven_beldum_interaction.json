{
    "initializationAction": [
        "v.requested = 'forretress';",
        "v.given = 'beldum nick=Iron helditem=cobblemon:dawn_stone ability=clearbody nature=brave ottype=NPC ot=Steven hp_iv=28 attack_iv=29 defence_iv=24 special_attack_iv=24 special_defence_iv=25 speed_iv=23';",
        "q.player.data.beldum_trade ? q.dialogue.set_page('after_trade');"
    ],
    "speakers": {
        "npc": {
            "name": "Steven",
            "face": "q.npc.face;"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "We meet again!",
                "Have you been to Hoenn before?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "It's such a beautiful place, with the clearest ocean you can imagine."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "You should visit sometime."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "Hey!",
                "Why don't we trade Pokémon?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "npc",
            "lines": [
                "I've been looking for Forretress.",
                "I can trade my Beldum for it."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": "q.dialogue.next_page;"
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('declined');"
                    }
                ]
            }
        },
        {
            "id": "page5",
            "speaker": "npc",
            "lines": [
                "OK, let's trade!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Ok",
                        "value": "ok",
                        "action": [
                            "v.success = q.run_script('pt_trade_pkmn', v.requested, v.given);",
                            "v.success ? { q.player.data.beldum_trade = 1; q.player.save_data };",
                            "v.success ? q.dialogue.set_page('trade') : q.dialogue.set_page('no_pokemon');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "trade",
            "speaker": "none",
            "lines": [
                "Steven sent over Iron.",
                "Bye-bye, Forretress!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "after_trade",
            "speaker": "npc",
            "lines": [
                "You don't see Forretress in the Hoenn region."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "after_trade2",
            "speaker": "npc",
            "lines": [
                "It's my first time to actually see one.",
                "Thank you so much!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "no_pokemon",
            "speaker": "npc",
            "lines": [
                "... is what I would say, if you had one."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "declined",
            "speaker": "npc",
            "lines": [
                "That's too bad."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}