{
    "initializationAction": [
        "q.player.data.loot.tms.naturalgift ? { q.dialogue.set_page('aftergift'); return 0 };",
        "q.player.data.flags.moomoofarm_quest >= 8 ? q.dialogue.set_page('gift');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Our milk even goes out to Kanto."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "So if our own Miltank won't give us any milk, we're in trouble."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "gift",
            "speaker": "npc",
            "lines": [
                "You fixed our Miltank, hon.",
                "Now it gives Moomoo Milk again."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "gift2",
            "speaker": "npc",
            "lines": [
                "Here's somethin' fer your trouble."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' if entity @s[tag=!DSSound] run function johto:sound/overwriterecord {track:\"gb/sfx_local/gettm\",duration:70}');",
                            "q.run_command('execute as ' + q.player.username + ' if entity @s[tag=DSSound] run function johto:sound/overwriterecord {track:\"ds/sfx_local/gettm\",duration:70}');",
                            "q.run_command('execute as ' + q.player.username + ' run givetm naturalgift 3');",
                            "q.player.data.loot.tms.naturalgift = 1; q.player.save_data;",
                            "q.dialogue.next_page;"
                        ]
                    }
                ]
            }
        },
        {
            "id": "loot",
            "speaker": "none",
            "lines": [
                "Obtained the Natural Gift TMs!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "aftergift",
            "speaker": "npc",
            "lines": [
                "That there's Natural Gift."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "aftergift2",
            "speaker": "npc",
            "lines": [
                "Its move type and Power will depend on the Berry yer Pokémon holds."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "aftergift3",
            "speaker": "npc",
            "lines": [
                "When you use it once, the Berry's gone.",
                "You best think how you ought to use it, hon."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}