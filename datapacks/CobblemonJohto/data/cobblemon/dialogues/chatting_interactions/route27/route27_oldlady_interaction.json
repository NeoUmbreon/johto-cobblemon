{
    "initializationAction": [
        "q.player.data.loot.tms.sandstorm ? { q.dialogue.set_page('aftergift'); return 0 };",
        "q.length(q.player.party.pokemon) == 0 ? { q.dialogue.set_page('nopokemon'); return 0 };",
        "q.set_query('friendship', q.player.party.pokemon.0.friendship);"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
