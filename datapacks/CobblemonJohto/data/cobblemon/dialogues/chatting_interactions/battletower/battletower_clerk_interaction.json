{
    "initializationAction": [
        "q.player.data.temp.players = q.array(q.player);"
    ],
    "speakers": {
        "npc": {
          "name": "Battle Tower Clerk",
          "face": {
            "type": "artificial",
            "modelType": "npc",
            "identifier": "cobblemon:shopman",
            "isLeftSide": true
          }
        }
      },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Welcome to the Battle Tower!"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "Would you like to take the Battle Room challenge?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": "q.dialogue.set_page('page3');"
                    },
                    {
                        "text": "Info",
                        "value": "info",
                        "action": "q.dialogue.set_page('info1');"
                    },
                    {
                        "text": "Records",
                        "value": "records",
                        "action": "q.dialogue.set_page('records');"
                    },
                    {
                        "text": "Restrictions",
                        "value": "restrictions",
                        "action": "q.dialogue.set_page('restrictions');"
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "Which battle format would you like? Single, Double, Triple, or Multi?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Single Battle",
                        "value": "single",
                        "action": [
                            "v.format = 'SINGLES';",
                            "v.room = q.run_script('johto:assign_room');",
                            "v.validated = q.run_script('johto:validate_party');",
                            "v.room != 0 && v.validated == 1 ? { q.npc.world.server.data.battle_tower.room.[v.room] = 1; q.npc.world.server.save_data; q.dialogue.set_page('success1') } : { v.room == 0 ? q.dialogue.set_page('full1') : q.dialogue.set_page('invalidparty1'); };"
                        ]
                    },
                    {
                        "text": "Double Battle",
                        "value": "double",
                        "action": [
                            "v.format = 'DOUBLES';",
                            "v.room = q.run_script('johto:assign_room');",
                            "v.validated = q.run_script('johto:validate_party');",
                            "v.room != 0 && v.validated == 1 ? { q.npc.world.server.data.battle_tower.room.[v.room] = 1; q.npc.world.server.save_data; q.dialogue.set_page('success1') } : { v.room == 0 ? q.dialogue.set_page('full1') : q.dialogue.set_page('invalidparty1'); };"
                        ]
                    },
                    {
                        "text": "Triple Battle",
                        "value": "triple",
                        "action": [
                            "v.format = 'TRIPLES';",
                            "v.room = q.run_script('johto:assign_room');",
                            "v.validated = q.run_script('johto:validate_party');",
                            "v.room != 0 && v.validated == 1 ? { q.npc.world.server.data.battle_tower.room.[v.room] = 1; q.npc.world.server.save_data; q.dialogue.set_page('success1') } : { v.room == 0 ? q.dialogue.set_page('full1') : q.dialogue.set_page('invalidparty1'); };"
                        ]
                    },
                    {
                        "text": "Multi Battle",
                        "value": "multi",
                        "action": [
                            "q.dialogue.set_page('salon1');"
                        ]
                    },
                    {
                        "text": "Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('page2');"
                        ]
                    }
                ]
            }
        },
        

        {
            "id": "success1",
            "speaker": "npc",
            "escapeAction": [
                "q.run_script('johto:init_room');",
                "q.dialogue.close;"
            ],
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Your assigned Battle Room is Room ' + v.room + '.'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('success2');"
                    }
                ]
            }
        },
        {
            "id": "success2",
            "speaker": "npc",
            "escapeAction": [
                "q.run_script('johto:init_room');",
                "q.dialogue.close;"
            ],
            "lines": [
                "I will now show you to your Battle Room."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_script('johto:init_room');",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        },

        
        {
            "id": "salon1",
            "speaker": "npc",
            "escapeAction": [
                "q.player.add_tag('BattleSalon');",
                "q.dialogue.close;"
            ],
            "lines": [
                "I will now show you to the Battle Salon."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.player.add_tag('BattleSalon');",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        },


        {
            "id": "info1",
            "speaker": "npc",
            "lines": [
                "The Battle Tower is a facility for Battle challenges."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('info2');"
                    }
                ]
            }
        },
        {
            "id": "info2",
            "speaker": "npc",
            "lines": [
                "Once entered, your challenge lasts until you lose."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('info3');"
                    }
                ]
            }
        },
        {
            "id": "info3",
            "speaker": "npc",
            "lines": [
                "We have four available battle formats: Single, Double, Triple, and Multi."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('info8');"
                    }
                ]
            }
        },
        {
            "id": "info8",
            "speaker": "npc",
            "lines": [
                "The battles are held in Battle Rooms, of which there are three in the tower."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('info9');"
                    }
                ]
            }
        },
        {
            "id": "info9",
            "speaker": "npc",
            "lines": [
                "In each of the Battle Rooms, many Trainers await your challenge."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('info10');"
                    }
                ]
            }
        },
        {
            "id": "info10",
            "speaker": "npc",
            "lines": [
                "If you manage to win seven battles in a row, you will earn Battle Points (BP)."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('info11');"
                    }
                ]
            }
        },
        {
            "id": "info11",
            "speaker": "npc",
            "lines": [
                "You may stay as long as you like, and you may interrupt your challenge at any time."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('info12');"
                    }
                ]
            }
        },
        {
            "id": "info12",
            "speaker": "npc",
            "lines": [
                "However, if you interrupt your challenge while in a battle, you will be disqualified."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('info13');"
                    }
                ]
            }
        },
        {
            "id": "info13",
            "speaker": "npc",
            "lines": [
                "Please be aware of that!"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Ok",
                        "value": "back",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },


        {
            "id": "restrictions",
            "speaker": "npc",
            "lines": [
                "What would you like to know?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "1) Party Size",
                        "value": "1",
                        "action": "q.dialogue.set_page('restriction1-1');"
                    },
                    {
                        "text": "2) Pokémon",
                        "value": "2",
                        "action": "q.dialogue.set_page('restriction2-1');"
                    },
                    {
                        "text": "3) Held Items",
                        "value": "3",
                        "action": "q.dialogue.set_page('restriction3-1');"
                    },
                    {
                        "text": "4) Battle",
                        "value": "4",
                        "action": "q.dialogue.set_page('restriction4-1');"
                    },
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "restriction1-1",
            "speaker": "npc",
            "lines": [
                "In Single Battle format, you enter with three Pokémon."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction1-2",
            "speaker": "npc",
            "lines": [
                "In Double Battle format, you enter with four Pokémon."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction1-3",
            "speaker": "npc",
            "lines": [
                "In Triple Battle format, you enter with six Pokémon."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction1-4",
            "speaker": "npc",
            "lines": [
                "Finally, in Multi Battle format, teams of two Trainers enter with two Pokémon each."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Ok",
                        "value": "back",
                        "action": "q.dialogue.set_page('restrictions');"
                    }
                ]
            }
        },
        {
            "id": "restriction2-1",
            "speaker": "npc",
            "lines": [
                "All Pokémon in your party must be of a different species."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction2-2",
            "speaker": "npc",
            "lines": [
                "Additionally, no Trainer in a Multi Team can enter a Pokémon of the same species as another Trainer's."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction2-3",
            "speaker": "npc",
            "lines": [
                "Mewtwo, Mew, Lugia, Ho-Oh, Celebi, Kyogre, Groudon, Rayquaza, Jirachi, Deoxys, Dialga, Palkia, Giratina, Phione, Manaphy, Darkrai, Shaymin, and Arceus are not allowed to enter."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Ok",
                        "value": "back",
                        "action": "q.dialogue.set_page('restrictions');"
                    }
                ]
            }
        },
        {
            "id": "restriction3-1",
            "speaker": "npc",
            "lines": [
                "All Pokémon in your party must be holding different items."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction3-2",
            "speaker": "npc",
            "lines": [
                "You cannot change your Pokémon's held items during your challenge."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction3-3",
            "speaker": "npc",
            "lines": [
                "Additionally, the item Soul Dew is not allowed."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Ok",
                        "value": "back",
                        "action": "q.dialogue.set_page('restrictions');"
                    }
                ]
            }
        },
        {
            "id": "restriction4-1",
            "speaker": "npc",
            "lines": [
                "Items cannot be used during a battle."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction4-2",
            "speaker": "npc",
            "lines": [
                "All Pokémon above level 50 will be set to level 50. Those under level 50 will remain at their current level."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction4-3",
            "speaker": "npc",
            "lines": [
                "Your Pokémon's original levels will be restored upon leaving the Battle Tower."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "restriction4-4",
            "speaker": "npc",
            "lines": [
                "Additionally, your Pokémon will not gain experience points or effort values during your challenge."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Ok",
                        "value": "back",
                        "action": "q.dialogue.set_page('restrictions');"
                    }
                ]
            }
        },


        {
            "id": "records",
            "speaker": "npc",
            "lines": [
                "Current / Lifetime Win Streaks",
                {
                    "type": "expression",
                    "expression": "'Single: ' + q.player.data.battle_tower.streaks.current.singles + ' / ' + q.player.data.battle_tower.streaks.lifetime.singles"
                },
                {
                    "type": "expression",
                    "expression": "'Double: ' + q.player.data.battle_tower.streaks.current.doubles + ' / ' + q.player.data.battle_tower.streaks.lifetime.doubles"
                },
                {
                    "type": "expression",
                    "expression": "'Triple: ' + q.player.data.battle_tower.streaks.current.triples + ' / ' + q.player.data.battle_tower.streaks.lifetime.triples"
                },
                {
                    "type": "expression",
                    "expression": "'Multi: ' + q.player.data.battle_tower.streaks.current.multi + ' / ' + q.player.data.battle_tower.streaks.lifetime.multi"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },


        {
            "id": "invalidparty1",
            "speaker": "npc",
            "escapeAction": [
                "for_each(t.str, v.validated, { q.run_command('tellraw ' + q.player.username + t.str); });",
                "q.dialogue.close;"
            ],
            "lines": [
                "Excuse me!"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('invalidparty2');"
                    }
                ]
            }
        },
        {
            "id": "invalidparty2",
            "speaker": "npc",
            "escapeAction": [
                "for_each(t.str, v.validated, { q.run_command('tellraw ' + q.player.username + t.str); });",
                "q.dialogue.close;"
            ],
            "lines": [
                "We found some issues with your party."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('invalidparty3');"
                    }
                ]
            }
        },
        {
            "id": "invalidparty3",
            "speaker": "npc",
            "escapeAction": [
                "for_each(t.str, v.validated, { q.run_command('tellraw ' + q.player.username + t.str); });",
                "q.dialogue.close;"
            ],
            "lines": [
                "Please come see me when you are ready."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "for_each(t.str, v.validated, { q.run_command('tellraw ' + q.player.username + t.str); });",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        },


        {
            "id": "full1",
            "speaker": "npc",
            "lines": [
                "Sorry, it appears all of our rooms are currently full!"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('full2');"
                    }
                ]
            }
        },
        {
            "id": "full2",
            "speaker": "npc",
            "lines": [
                "If you would like to, you may spectate the Battle Rooms from the observation decks."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('full3');"
                    }
                ]
            }
        },
        {
            "id": "full3",
            "speaker": "npc",
            "lines": [
                "Please come back here to join when one is available!"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        },


        {
            "id": "end",
            "speaker": "npc",
            "lines": [
                "We hope to see you again!"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}