{
    "initializationAction": [
        "q.player.data.loot.tms.taunt ? q.dialogue.set_page('aftergift');"
    ],
    "speakers": {
        "npc": {
            "name": "     ",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:medium",
                "isLeftSide": true
            }
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Oh, honey. You're making a Pokédex?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page1",
            "speaker": "npc",
            "lines": [
                "You must be battling all kinds of Pokémon."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "Try using these TMs for a change."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' if entity @s[tag=!DSSound] run function johto:sound/overwriterecord {track:\"gb/sfx_local/gettm\",duration:70}');",
                            "q.run_command('execute as ' + q.player.username + ' if entity @s[tag=DSSound] run function johto:sound/overwriterecord {track:\"ds/sfx_local/gettm\",duration:70}');",
                            "q.run_command('execute as ' + q.player.username + ' run givetm taunt 3');",
                            "q.player.data.loot.tms.taunt = 1; q.player.save_data;",
                            "q.dialogue.next_page;"
                        ]
                    }
                ]
            }
        },
        {
            "id": "loot",
            "speaker": "none",
            "lines": [
                "Obtained the Taunt TMs!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "aftergift",
            "speaker": "npc",
            "lines": [
                "It's Taunt."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "Use it and the target Pokémon can only use moves that do damage to your Pokémon for a while."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        }
    ]
}