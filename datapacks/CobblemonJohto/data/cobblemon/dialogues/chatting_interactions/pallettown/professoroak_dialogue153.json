            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "npc",
            "lines": [
                "For all your hard work, I would like to give you something."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page5",
            "speaker": "npc",
            "lines": [
                "Haha!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page6",
            "speaker": "npc",
            "lines": [
                "You must have figured it out right away."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page7",
            "speaker": "npc",
            "lines": [
                "Yes, it is a Pokémon!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page8",
            "speaker": "npc",
            "lines": [
                "You don't see them very often in Kanto."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page9",
            "speaker": "npc",
            "lines": [
                "Choose one and it'll be yours!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "v.prompt = '...Go ahead!';",
                            "q.dialogue.next_page;"
                        ]
                    }
                ]
            }
        },
        {
            "id": "choose",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "v.prompt"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c Charmander §r",
                        "value": "charmander",
                        "action": [
                            "v.message = 'So, you\\'re claiming the Fire Pokémon Charmander?';",
                            "v.choice = 'Charmander';",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "§b Squirtle §r",
                        "value": "squirtle",
                        "action": [
                            "v.message = 'So, you\\'ve decided on the Water Pokémon Squirtle?';",
                            "v.choice = 'Squirtle';",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "§a Bulbasaur §r",
                        "value": "bulbasaur",
                        "action": [
                            "v.message = 'So, you want to go with the Grass Pokémon Bulbasaur?';",
                            "v.choice = 'Bulbasaur';",
                            "q.dialogue.next_page;"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pick",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "v.message"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": "q.dialogue.next_page;"
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": [
                            "v.prompt = 'No need to hurry.\nTake your time.';",
                            "q.dialogue.set_page('choose');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "chosen",
            "speaker": "npc",
            "lines": [
                "This Pokémon is really quite energetic!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('tag ' + q.player.username + ' add Dialogue153');",
                            "q.run_command('execute as ' + q.player.username + ' run function johto:sound/playlocalsfx {sfx:\"caughtmon\"}');",
                            "q.run_command('execute as ' + q.player.username + ' run pokegive ' + v.choice + ' level=5');",
                            "q.dialogue.next_page;"
                        ]
                    }
                ]
            }
        },
        {
            "id": "gift",
            "speaker": "none",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'You received the ' + v.choice + ' from Professor Oak!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page12",
            "speaker": "npc",
            "lines": [
                "If a wild Pokémon appears, your Pokémon can battle it."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page13",
            "speaker": "npc",
            "lines": [
                "With it at your side, you should be able to reach the next town..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page14",
            "speaker": "npc",
            "lines": [
                "What am I saying?",
                "You already know all this!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page15",
            "speaker": "npc",
            "lines": [
                "Hahaha!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        }
    ]
}