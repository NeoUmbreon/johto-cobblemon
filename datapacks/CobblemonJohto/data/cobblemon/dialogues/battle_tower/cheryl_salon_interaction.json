{
    "initializationAction": [
        "q.run_script('johto:init_partner_dialogue');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'I have a ' + v.display_party.0.species + ' that is very good with ' + v.display_party.0.move + ' and a ' + v.display_party.1.species + ' that likes to show off its ' + v.display_party.1.move + '.'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "isVisible": "!v.joined",
                        "action": "q.dialogue.next_page;"
                    },
                    {
                        "text": "Close",
                        "value": "close",
                        "isVisible": "v.joined",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "prompt",
            "speaker": "npc",
            "lines": [
                "Will you team up with me?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "q.append(q.player.data.temp.npcs, q.npc.name);",
                            "q.dialogue.set_page('accept');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('decline');"
                    }
                ]
            }
        },
        {
            "id": "accept",
            "speaker": "npc",
            "lines": [
                "I'll wait for you, then."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "decline",
            "speaker": "npc",
            "lines": [
                "Oh...",
                "Too bad..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}