{
    "initializationAction": [
        "q.player.in_battle || q.npc.has_tag('Locked') ? q.dialogue.close;"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'You will be facing opponent no. ' + q.npc.data.battle_num + '. Are you ready?';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "for_each(t.player, q.player.data.temp.players, { t.player != q.player && t.player.active_dialogue.current_page.id != 'waiting' ? { v.wait = 1; break }; });",

                            "v.wait ? { for_each(t.player, q.player.data.temp.players, { t.player != q.player ? { t.player.tell(q.player.username + ' is ready!'); q.run_command('execute as ' + t.player.username + ' at @s run playsound entity.experience_orb.pickup'); }; }); q.dialogue.set_page('waiting') };",
                            "!v.wait ? { for_each(t.player, q.player.data.temp.players, { t.player.add_tag('BattleTowerReady'); t.player != q.player ? { t.player.active_dialogue.close; t.player.tell('Starting battle...'); }; }); q.npc.add_tag('Locked'); q.npc.walk_to(902,q.npc.y,57,0.5); q.dialogue.set_page('yes'); };"                    
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": [
                            "q.dialogue.set_page('no');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "waiting",
            "speaker": "npc",
            "escapeAction": [],
            "lines": [
                "Waiting for your team..."
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Cancel",
                        "value": "cancel",
                        "action": [
                            "for_each(t.player, q.player.data.temp.players, { t.player != q.player ? { t.player.tell(q.player.username + ' is no longer ready'); }; });",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        },
        {
            "id": "yes",
            "speaker": "npc",
            "escapeAction": [
                "q.run_script('johto:start_battle') == 0 ? { q.npc.remove_tag('Locked') };",
                "q.dialogue.close;"
            ],
            "lines": [
                "I'll get your next battle set up!"
            ],
            "input": {
                "type": "auto-continue",
                "delay": 1.5,
                "allowSkip": true,
                "showTimer": true,
                "action": [
                    "q.run_script('johto:start_battle') == 0 ? { q.npc.remove_tag('Locked') };",
                    "q.dialogue.close;"
                ]
            }
        },
        {
            "id": "no",
            "speaker": "npc",
            "lines": [
                "Would you like to leave the Battle Tower?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "giveup",
                        "action": [
                            "v.player = q.player;",
                            "q.run_script('johto:leave_tower');",
                            "q.dialogue.close;"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "continue",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}