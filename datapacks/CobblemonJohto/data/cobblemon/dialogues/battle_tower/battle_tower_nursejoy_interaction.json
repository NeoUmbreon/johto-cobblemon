{
    "initializationAction": [
        "q.player.in_battle || q.npc.has_tag('Locked') ? q.dialogue.close : q.run_script('johto:init');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'You will be facing opponent no. ' + q.npc.data.battle_num + '. Are you ready?';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "t.not_ready = q.array();",
                            "for_each(t.player, q.npc.data.players, { ( !t.player.has_tag('BattleTowerReady') && t.player.username != q.player.username ) ? q.append(t.not_ready, t.player); });",

                            "q.length(t.not_ready) == 0 ? { q.run_command('execute as @a[tag=BattleTowerFloor_' + q.npc.data.floor + ',name=!' + q.player.username + '] run runmolang q.entity.active_dialogue.close'); q.run_command('tellraw @a[tag=BattleTowerFloor_' + q.npc.data.floor + ',name=!' + q.player.username + '] \"Starting battle!\"'); q.npc.add_tag('Locked'); q.dialogue.set_page('yes'); };",
                            "q.length(t.not_ready) != 0 ? { !q.player.has_tag('BattleTowerReady') ? { q.run_command('tellraw @a[tag=BattleTowerFloor_' + q.npc.data.floor + '] \"' + q.player.username + ' is ready!\"'); q.dialogue.close; } : q.dialogue.close; };",
                            
                            "q.player.add_tag('BattleTowerReady');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": [
                            "q.player.has_tag('BattleTowerReady') ? q.run_command('tellraw @a[tag=BattleTowerFloor_' + q.npc.data.floor + '] \"' + q.player.username + ' is no longer ready!\"');",
                            "q.player.remove_tag('BattleTowerReady');",
                            "q.dialogue.set_page('no');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "yes",
            "speaker": "npc",
            "escapeAction": [],
            "lines": [
                "I'll get your next battle set up!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_script('johto:spawn_and_battle') == 0 ? { q.npc.remove_tag('Locked') };",
                            "q.dialogue.close;"
                        ]
                    }
                ]
            }
        },
        {
            "id": "no",
            "speaker": "npc",
            "lines": [
                "Would you like to leave the Battle Tower?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "giveup",
                        "action": [
                            "q.player.remove_tag('BattleTowerFloor_' + q.npc.data.floor);",
                            "q.run_command('tellraw @a[tag=BattleTowerFloor_' + q.npc.data.floor + '] \"' + q.player.username + ' left the party\"');",
                            "for_each(t.player, q.npc.data.players, { t.player.username == q.player.username ? { q.delete(q.npc.data.players, t.i); break; }; t.i = t.i + 1; });",
                            "q.npc.save_data;",
                            "q.dialogue.set_page('giveupconfirm');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "continue",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "giveupconfirm",
            "speaker": "npc",
            "lines": [
                "We hope to see you again!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}