{
    "initializationAction": [
        "q.run_script('johto:init_partner_dialogue');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Hi, hi!",
                {
                    "type": "expression",
                    "expression": "'I\\'m with my ' + v.display_party.0.species + '!'"
                },
                {
                    "type": "expression",
                    "expression": "'It\\'s really good with ' + v.display_party.0.move + '!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'The other one is my ' + v.display_party.1.species + '.'"
                },
                {
                    "type": "expression",
                    "expression": "'Its ' + v.display_party.1.move + ' is awesome!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "isVisible": "!v.joined",
                        "action": "q.dialogue.next_page;"
                    },
                    {
                        "text": "Close",
                        "value": "close",
                        "isVisible": "v.joined",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "prompt",
            "speaker": "npc",
            "lines": [
                "Do you want to join with me?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "q.append(q.player.data.temp.npcs, q.npc.name);",
                            "q.dialogue.set_page('accept');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('decline');"
                    }
                ]
            }
        },
        {
            "id": "accept",
            "speaker": "npc",
            "lines": [
                "OK! I'll wait for you!",
                {
                    "type": "expression",
                    "expression": "q.player.username + ', don\\'t be long!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "decline",
            "speaker": "npc",
            "lines": [
                "Oh, OK.",
                "Let's go another time!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}