{
    "initializationAction": [
        "q.run_script('johto:init_partner_dialogue');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "The partners I have now?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Well, my ' + v.display_party.0.species + '\\'s nasty with its ' + v.display_party.0.move + '.'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'And there\\'s my ' + v.display_party.1.species + ', which is a sure hand with ' + v.display_party.1.move + '.'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "isVisible": "!v.joined",
                        "action": "q.dialogue.next_page;"
                    },
                    {
                        "text": "Close",
                        "value": "close",
                        "isVisible": "v.joined",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "prompt",
            "speaker": "npc",
            "lines": [
                "Would you like to team up with me?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "q.append(q.player.data.temp.npcs, q.npc.name);",
                            "q.dialogue.set_page('accept');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('decline');"
                    }
                ]
            }
        },
        {
            "id": "accept",
            "speaker": "npc",
            "lines": [
                "Ahaha, thanks.",
                "I'll be waiting for you."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "decline",
            "speaker": "npc",
            "lines": [
                "...Oh, is that so?",
                "That's too bad."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}