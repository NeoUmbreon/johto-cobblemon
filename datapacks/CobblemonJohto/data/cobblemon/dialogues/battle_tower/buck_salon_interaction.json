{
    "initializationAction": [
        "for_each(t.npc, q.player.data.temp.npcs, { t.npc == q.npc.name ? { v.joined = true; break }; });",
        "q.length(q.player.data.temp.npcs) > 0 && !v.joined ? q.dialogue.close;",
        "q.run_script('johto:generate_partner_party');",
        "v.pokemon = q.run_script('johto:get_partner_party');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Yo, are you looking to team up? Let me tell you what I've got."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'My ' + v.pokemon.0.species + '\\'s first-rate with ' + v.pokemon.0.move + '.'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'And my ' + v.pokemon.1.species + ' is the best when it comes to using ' + v.pokemon.1.move + '.'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "isVisible": "!v.joined",
                        "action": "q.dialogue.next_page;"
                    },
                    {
                        "text": "Close",
                        "value": "close",
                        "isVisible": "v.joined",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "prompt",
            "speaker": "npc",
            "lines": [
                "You want to go with me, don't you?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "q.append(q.player.data.temp.npcs, q.npc.name);",
                            "q.dialogue.set_page('accept');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('decline');"
                    }
                ]
            }
        },
        {
            "id": "accept",
            "speaker": "npc",
            "lines": [
                "Hehehe! Good choice!",
                "There's no problem when I'm around!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "decline",
            "speaker": "npc",
            "lines": [
                "Huh? What?",
                "That's pretty cold of you!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}