{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:exclamation",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "exclamation"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.lifetime = 1.2; v.scale = 0.45; v.height = 0.5;"
			},
			"minecraft:emitter_local_space": {
				"position": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "v.lifetime"
			},
			"minecraft:emitter_shape_point": {
				"direction": [0, 1, 0]
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.frame = v.particle_age * 30;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.lifetime"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [0, "v.frame < 6 ? v.height - (v.height / 9) * math.pow(v.frame - 3, 2) : 0", 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.scale", "v.scale"],
				"facing_camera_mode": "rotate_y",
				"uv": {
					"texture_width": 14,
					"texture_height": 14,
					"uv": [0, 0],
					"uv_size": [14, 14]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, "v.frame > 0 ? 1 : 0"]
			}
		}
	}
}